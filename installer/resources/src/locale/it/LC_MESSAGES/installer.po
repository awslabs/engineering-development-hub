msgstr "Seleziona un VPC esistente:"

msgid "Select at least 2 public subnets:"
msgstr "Seleziona almeno 2 sottoreti pubbliche:"

msgid "Select at least 2 private subnets:"
msgstr "Seleziona almeno 2 sottoreti private:"

msgid "where applications will be installed"
msgstr "dove verranno installate le applicazioni"

msgid "where user data will be stored"
msgstr "dove verranno archiviati i dati dell'utente"

