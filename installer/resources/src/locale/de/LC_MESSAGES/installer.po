"Private subnet IDs when using an existing VPC. Use + to specify more than"
" 1 subnet."
msgstr ""
"Private Subnetz-IDs bei Verwendung einer vorhandenen VPC. Verwenden Sie "
"+, um mehr als ein Subnetz anzugeben."

msgid "Select if you want to add Prefix List to your security groups."
msgstr ""
"Wählen Sie aus, ob Sie die Präfixliste zu Ihren Sicherheitsgruppen "
"hinzufügen möchten."

msgid "Filesystem provider for /apps (efs, fsx_lustre, fsx_ontap, fsx_openzfs)"
msgstr "Dateisystemanbieter für /apps (efs, fsx_lustre, fsx_ontap, fsx_openzfs)"

msgid "Existing filesystem DNS/IP for /apps"
msgstr "Bestehendes Dateisystem DNS/IP für /apps"

msgid "Filesystem provider for /data (efs, fsx_lustre, fsx_ontap, fsx_openzfs)"
msgstr "Dateisystemanbieter für /data (efs, fsx_lustre, fsx_ontap, fsx_openzfs)"

