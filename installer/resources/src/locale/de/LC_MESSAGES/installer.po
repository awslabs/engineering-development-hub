msgstr "{fs_id} auch als/{mount_point} mounten?"

msgid "Pick a different filesystem"
msgstr "Wählen Sie ein anderes Dateisystem"

msgid "Yes, share this filesystem"
msgstr "Ja, teile dieses Dateisystem"

#, python-brace-format
msgid "NFS access for /{mount_point}:"
msgstr "NFS-Zugriff für/{mount_point}:"

msgid "Re-check now"
msgstr "Prüfen Sie jetzt erneut"

msgid "Continue anyway, deployment may fail"
msgstr "Fahren Sie trotzdem fort, die Bereitstellung schlägt möglicherweise fehl"

#, python-brace-format
msgid "Select the filesystem provider for /{mount_point} ({purpose}):"
msgstr "Wählen Sie den Dateisystemanbieter für/{mount_point} ({purpose}):"

