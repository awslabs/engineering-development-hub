{% include "templates/linux/common.sh.j2" %}

# Validate umask
{% include "templates/linux/umask.sh.j2" %}

log_info "Setup Start Date: $(date)"
log_info "Running Kernel $(uname -r)"
unset_reboot_required

# Prevent script to be executed twice (or more)
if [[ -f "/root/.edh_bootstrap_controller_{{ context.get('/configuration/ClusterId') }}_completed" ]]; then
  exit_fail "/root/.edh_bootstrap_controller_{{ context.get('/configuration/ClusterId') }}_completed already exist. To prevent configuration overwrite, we exit the script, since this machine seems to be already configured"
fi

# Install JQ
{% include "templates/linux/jq.sh.j2" %}

{% if context.get("/job/BaseOS") in ("ubuntu2204", "ubuntu2404") %}
  log_info "Disabling auto-update on Ubuntu"
  sed -ie 's/"1"/"0"/g' /etc/apt/apt.conf.d/20auto-upgrades
{% endif %}


# Install and configure HPC schedulers.
# Note: Your SOCA_CONTROLLER can be the host of multiple schedulers
{% include "templates/linux/scheduler/install_schedulers.sh.j2" %}

# Configure default queues mapping file
{% include "templates/linux/scheduler/queues_mapping.sh.j2" %}

# Set default path
set_environment_variable "PATH" "/opt/edh/{{ context.get("/configuration/ClusterId") }}/python/latest/bin:/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin"

# Set Controller IP, not needed as you are already on the controller host, but making sure the variable exist to stay consistent with the other machines
set_environment_variable "EDH_CONTROLLER_IP" "$(get_ipv4_host_address)"

# Configure User Directory (AD/OpenLDAP)
{% if context.get("/configuration/UserDirectory/provider") in ["existing_openldap", "openldap"] %}
  {% if context.get("/configuration/UserDirectory/provider") == "existing_openldap" %}
    {% include "templates/linux/user_directory/openldap/openldap_client.sh.j2" %}
  {% else %}
    {% include "templates/linux/user_directory/openldap/openldap_server.sh.j2" %}
  {% endif %}
{% elif context.get("/configuration/UserDirectory/provider") in ["existing_active_directory", "aws_ds_managed_activedirectory"] %}
  {% include "templates/linux/user_directory/active_directory/join_activedirectory.sh.j2" %}
{% else %}
  exit_fail "UserDirectory/provider must be one of openldap, existing_openldap, existing_active_directory or aws_ds_managed_activedirectory. Detected {{ context.get("/configuration/UserDirectory/provider") }}"
{% endif %}

# Create default slurm user for PCS (optional and non-breaking in case of error)
{% include "templates/linux/scheduler/aws_pcs/default_slurm_user.sh.j2" %}

# Disable SSH StrictHostKey Checking
{% include "templates/linux/disable_ssh_strict_host_key_check.sh.j2" %}

# Configure Chronyd
{% include "templates/linux/chronyd.sh.j2" %}

# Disable ulimits
{% include "templates/linux/disable_ulimits.sh.j2" %}

# Install NodeJS
{% include "templates/linux/nodejs.sh.j2" %}

# Install required Node modules
${EDH_BOOTSTRAP_ASSETS_FOLDER}/node/bin/npm install --prefix "/opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/web_interface/static" monaco-editor@0.52.0

# Start Schedulers
{% include "templates/linux/scheduler/start_scheduler_services.sh.j2" %}

# Create crontabs
echo "
# SOCA Info: Add export SOCA_DEBUG=1 to enable DEBUG capability
# ex: export SOCA_DEBUG=1; source /etc/environment; /opt/edh/{{ context.get("/configuration/ClusterId") }}/python/latest/bin/python3  /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/orchestrator/nodes_manager.py
###################
# SOCA Variables
###################

###################
# Cluster Analytics
###################

* * * * * /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/analytics/wrapper.sh cluster_nodes_tracking
@hourly /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/analytics/wrapper.sh job_tracking
*/10 * * * * /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/analytics/wrapper.sh desktop_hosts_tracking
*/10 * * * * /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/analytics/wrapper.sh target_nodes_tracking

########################
# Cluster Log Management
########################

@daily source /etc/environment; /bin/bash /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/logs_management/send_logs_s3.sh

####################
# Cluster Management
####################

* * * * * /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/orchestrator/nodes_manager.sh

# Automatic Host Provisioning

* * * * * /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/orchestrator/jobs_dispatcher.sh compute
* * * * * /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/orchestrator/jobs_dispatcher.sh job-shared
* * * * * /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/orchestrator/jobs_dispatcher.sh test

# Add/Remove DCV hosts and configure ALB
*/3 * * * *  source /opt/edh/{{ context.get("/configuration/ClusterId") }}/python/latest/edh_python.env; \
/opt/edh/{{ context.get("/configuration/ClusterId") }}/python/latest/bin/python3 /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/orchestrator/dcv_alb_manager.py

################
# Cluster Web UI
################

# Restart UI at reboot
@reboot /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/web_interface/edhwebui.sh start

{% if context.get("/configuration/UserDirectory/provider") in ["existing_active_directory", "aws_ds_managed_activedirectory"] %}

############################
# AD Sync Users Mapping File
############################

# Note: If no job are submitted, script freshness will be updated automatically every 3 hours. Otherwise dispatcher will update every 30 mins is there is active jobs in the queue.
0 */3 * * * source /opt/edh/{{ context.get("/configuration/ClusterId") }}/python/latest/edh_python.env; /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/edhctl ad export

{% endif %} 

" | crontab -

# Generate 10 years internal SSL certificate for Soca Web UI
pushd /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/web_interface
openssl req -new -newkey rsa:4096 -days 3650 -nodes -x509 \
    -subj "/C=US/ST=California/L=Sunnyvale/CN=internal.edh.webui.cert" \
    -keyout cert.key -out cert.crt

# Start Web UI
chmod +x /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/web_interface/edhwebui.sh
chmod +x /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/web_interface/socawebui.sh # legacy
./edhwebui.sh start

# Wait until the endpoint is reachable
sleep 30

START_WEB_UI_MAX_ATTEMPT=10
START_WEB_UI_CURRENT_ATTEMPT=0
while [[ "$(curl https://localhost:8443/ping --insecure  -s -o /dev/null -w '%{http_code}')" != "200" ]]; do
  ((START_WEB_UI_CURRENT_ATTEMPT=START_WEB_UI_CURRENT_ATTEMPT+1))
  if [[ $START_WEB_UI_CURRENT_ATTEMPT -ge $START_WEB_UI_MAX_ATTEMPT ]]; then
      exit_fail "error: Timed out waiting for starting the web interface. please check uwsgi logs under /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/web_interface/logs/ and run the create user command manually."
  fi
  log_info "Web UI is not returning HTTP/200 ... restarting process ... "
  ./edhwebui.sh stop
  sleep 10
  ./edhwebui.sh start
  sleep 30
done
log_info "Web UI is ready and serving requests ... "

# Create default home structure
mkdir -p /data/home

# This is only available when SOCA creates the User/secret
# Existing deployments do not have this secret populated since they leverage a admin-populated secret
{% if context.get("/configuration/UserDirectory/provider") in ["aws_ds_managed_activedirectory", "openldap"] %}
  SOCA_DEFAULT_ADMIN_USER=$(get_secret "/edh/{{ context.get("/configuration/ClusterId") }}/EDHAdminUser")
{% endif %}

{% if context.get("/configuration/UserDirectory/provider") in ["aws_ds_managed_activedirectory"] %}
  # Create default AD Admin Group if needed
  SOCA_AD_ADMINS_SEARCH_BASE="{{ context.get("/configuration/UserDirectory/admins_search_base") | lower }}"
  SOCA_AD_ADMIN_GROUP_NAME=$(echo ${SOCA_AD_ADMINS_SEARCH_BASE} | awk -F'[,=]' '{print $2}')
  MAX_CREATE_ADMIN_GROUP_ATTEMPT=5
  CREATE_ADMIN_GROUP_ATTEMPT_COUNT=0
  log_info "Creating default SOCA Admin Group on Directory Service"
  while true; do
    REQUEST_HTTP_CODE_CREATE_GROUP=$(curl --silent -k -H "X-EDH-TOKEN: $(cat /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/web_interface/keys/admin_api_key.txt)" \
      --data-urlencode "group=${SOCA_AD_ADMIN_GROUP_NAME}"  \
      -w "%{http_code}" -o ${EDH_BOOTSTRAP_LOGS_FOLDER}/create_admin_group.log -X POST https://127.0.0.1:8443/api/ldap/group)

    if [[ ${REQUEST_HTTP_CODE_CREATE_GROUP} == "200" ]]; then
      log_info "SOCA Admin Group created successfully."
      break
    else
      log_info "Unable to create SOCA Admin Group due to $(cat ${EDH_BOOTSTRAP_LOGS_FOLDER}/create_admin_group.log), trying again soon ..."
      ((CREATE_ADMIN_GROUP_ATTEMPT_COUNT++))

      if [[ ${CREATE_ADMIN_GROUP_ATTEMPT_COUNT} -ge ${MAX_CREATE_ADMIN_GROUP_ATTEMPT} ]]; then
        echo "Unable to create SOCA Admin Group after ${MAX_CREATE_ADMIN_GROUP_ATTEMPT} attempts, bootstrap sequence will continue."
        break
      fi
      sleep 10
    fi
  done
{% elif context.get("/configuration/UserDirectory/provider") in ["existing_active_directory", "existing_openldap"]  %}
  log_info "Using an existing Active Directory or OpenLDAP, skipping Admin Group Creation"
{% endif %}


{% if context.get("/configuration/UserDirectory/provider") not in ["existing_active_directory", "existing_openldap"]  %}
  # Create default LDAP user with admin privileges
  MAX_CREATE_USER_ATTEMPT=5
  CREATE_USER_ATTEMPT_COUNT=0
  while true; do
    REQUEST_HTTP_CODE_CREATE_USER=$(curl --silent -k -H "X-EDH-TOKEN: $(cat /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/web_interface/keys/admin_api_key.txt)" \
      --data-urlencode "user=$(echo ${SOCA_DEFAULT_ADMIN_USER} | jq -r ". | fromjson.username")" \
      --data-urlencode "password=$(echo ${SOCA_DEFAULT_ADMIN_USER} | jq -r ". | fromjson.password")" \
      --data-urlencode "sudoers=1" \
      --data-urlencode "email=admin@edh" \
      --data-urlencode "uid=0" \
      --data-urlencode "gid=0" \
      -w "%{http_code}" -o ${EDH_BOOTSTRAP_LOGS_FOLDER}/create_new_user.log -X POST https://127.0.0.1:8443/api/ldap/user)

    if [[ ${REQUEST_HTTP_CODE_CREATE_USER} == "200" ]]; then
      log_info "User created successfully."
      break
    else
      log_warning "Unable to create new user due to $(cat ${EDH_BOOTSTRAP_LOGS_FOLDER}/create_new_user.log), trying again soon ..."
      ((CREATE_USER_ATTEMPT_COUNT++))

      if [[ ${CREATE_USER_ATTEMPT_COUNT} -ge ${MAX_CREATE_USER_ATTEMPT} ]]; then
        log_error "Unable to create user after ${MAX_CREATE_USER_ATTEMPT} attempts, bootstrap sequence will continue."
        break
      fi

      sleep 10
    fi
  done

  # Validate that the directory holds POSIX identity in the attributes an FSx
  # for NetApp ONTAP SVM reads. Runs here because it needs this host's machine
  # keytab (from the realm join above) and the admin user created by the loop
  # above. Warn-only, and a no-op when no fsx_ontap filesystem is configured.
  {% include "templates/linux/shared_storage/fsx/ontap/validate_directory_attributes.sh.j2" %}
  fsx_ontap_validate_directory_attributes
{% else %}
  log_info "Using an existing Active Directory or OpenLDAP, skipping User Creation"
{%  endif %}


# Tag EBS disks manually as CFN ASG does not support it
{% include "templates/linux/tags/ebs.sh.j2" %}

# Tag Network Interface for the Compute Node
{% include "templates/linux/tags/eni.sh.j2" %}

# Configure Message Of The Day (MOTD)
{% include "templates/linux/motd.sh.j2" %}

# Install edhctl shell tab completion for admin login shells
{% include "templates/linux/edhctl_completion.sh.j2" %}

# Restart/Enable crond
{% if context.get("/job/BaseOS") in ("ubuntu2204", "ubuntu2404") %}
  systemctl enable cron
  systemctl restart cron
{% else %}
  systemctl enable crond
  systemctl restart crond
{% endif %}

# Restrict SSH to SOCA Controller Host
{% include "templates/linux/restrict_ssh_access.sh.j2" %}

# Create bootstrap lock
touch "/root/.edh_bootstrap_controller_{{ context.get('/configuration/ClusterId') }}_completed"

# Install CloudWatch Log Agent
{% include "templates/linux/aws_cloudwatch_agent.sh.j2" %}

# Todo? run some awscli describe-instance and populate the cache?

# Stage shared sample-app payloads under /apps/edh/<cluster_id>/job_samples/
{% include "templates/linux/edh_job_samples.sh.j2" %}

{% if context.get("/configuration/services/cross_region/enabled") == True %}
########################################
# Cross-region overlay mesh daemon
########################################
# Rendered late in the bootstrap chain on purpose. An earlier template races
# CDK's SSM parameter creation, and because every value below is read through
# context.get, losing that race renders the whole block with empty values
# rather than failing.
log_info "[cross-region] installing edh-overlay-daemon"
chmod +x /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/overlay_daemon/scripts/*.sh

set_environment_variable "EDH_REGION" "{{ context.get("/configuration/Region") }}"
set_environment_variable "EDH_MESH_ID" "{{ context.get("/configuration/Overlay/mesh_id") }}"
# Tables are named edh_<prefix>_<short_name>. The prefix is resolved at install
# time from the mesh id plus any override, and the daemon refuses to start
# without it rather than addressing an unprefixed table.
set_environment_variable "EDH_MESH_TABLE_PREFIX" "{{ context.get("/configuration/Overlay/mesh_table_prefix") }}"
set_environment_variable "EDH_WG_SECRET_ARN" "{{ context.get("/configuration/Overlay/wg_secret_arn") }}"
set_environment_variable "EDH_LISTEN_PORT" "{{ context.get("/configuration/services/cross_region/overlay/listen_port", 51820) }}"
set_environment_variable "EDH_MTU" "{{ context.get("/configuration/services/cross_region/overlay/mtu", 1280) }}"
set_environment_variable "EDH_SYNC_INTERVAL_SECONDS" "{{ context.get("/configuration/services/cross_region/overlay/sync_interval_seconds", 30) }}"
set_environment_variable "EDH_BOOTSTRAP_WAIT" "{{ context.get("/configuration/services/cross_region/bootstrap_wait_seconds", 0) }}"
# Mesh-wide lifecycle policy, written into the mesh metadata row by whichever
# cluster creates the mesh. Exported because that write happens ONCE and there
# is no update path yet, so a value frozen in the daemon would permanently
# override the operator's configuration for the life of the mesh.
set_environment_variable "EDH_KEY_ROTATION_DAYS" "{{ context.get("/configuration/services/cross_region/overlay/key_rotation_days", 90) }}"
set_environment_variable "EDH_AUTO_DECOMMISSION_DAYS" "{{ context.get("/configuration/services/cross_region/overlay/auto_decommission_days", 90) }}"
set_environment_variable "EDH_DECOMMISSION_TO_TOMBSTONE_DAYS" "{{ context.get("/configuration/services/cross_region/overlay/decommission_to_tombstone_days", 30) }}"
{% if context.get("/configuration/Overlay/mesh_role_arn") %}
set_environment_variable "EDH_MESH_ROLE_ARN" "{{ context.get("/configuration/Overlay/mesh_role_arn") }}"
{% endif %}
{% if context.get("/configuration/Overlay/mesh_role_external_id") %}
set_environment_variable "EDH_MESH_ROLE_EXTERNAL_ID" "{{ context.get("/configuration/Overlay/mesh_role_external_id") }}"
{% endif %}
# Sourced so the installer invoked below sees the exports just written.
source /etc/environment

if /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/overlay_daemon/scripts/install-overlay-daemon.sh \
        >>${EDH_BOOTSTRAP_LOGS_FOLDER}/install_overlay_daemon.log 2>&1; then
    log_info "[cross-region] edh-overlay-daemon installed"
else
    # $? in this branch is the installer's status, and it MUST fail the install.
    #
    # This was a log_info WARN, which demoted the installer's non-zero exit to a
    # line in a log nobody reads and let the controller install report success.
    # That defeated the one thing install-overlay-daemon.sh is built around: its
    # header states that step 2 is the one step allowed to fail the controller
    # install, because a cluster that cannot determine whether it is creating or
    # joining a mesh must not proceed, since guessing produces two clusters with
    # conflicting address plans. It exits 4 for exactly that case.
    #
    # exit_fail is the same helper every other failure in this template uses.
    _edh_overlay_rc=$?
    exit_fail "[cross-region] install-overlay-daemon.sh exited ${_edh_overlay_rc}. The overlay mesh state could not be established, so this controller must not continue: proceeding without knowing whether it created or joined the mesh risks a second cluster claiming the same address plan. See ${EDH_BOOTSTRAP_LOGS_FOLDER}/install_overlay_daemon.log for the cause. To recover WITHOUT rebuilding this controller, fix the cause and re-run that one script directly as root: /opt/edh/{{ context.get('/configuration/ClusterId') }}/cluster_manager/overlay_daemon/scripts/install-overlay-daemon.sh . It is idempotent and reads its inputs from /etc/environment, which is already populated. Do NOT re-run this bootstrap script: the completion lock written earlier at /root/.edh_bootstrap_controller_{{ context.get('/configuration/ClusterId') }}_completed makes it exit at its own guard."
fi

########################################
# Cross-region mesh sidecar
########################################
# After the daemon install, because the sidecar binds an address on edh-mesh0 and
# that interface is brought up by the daemon unit's own ExecStartPre. The unit this
# installs is ordered After=edh-overlay-daemon.service as well, so the ordering
# holds on every later boot and not only on this one.
#
# Deliberately NOT exit_fail on failure, which is the opposite of the block above.
# A controller with no sidecar serves no peer-facing mesh routes and is otherwise
# a working cluster, and the unit carries Restart=always, so the ordinary case of
# an interface that is a moment late resolves without an operator. Failing the
# whole controller install over it would trade a degraded mesh for no cluster.
log_info "[cross-region] installing edh-mesh-sidecar"
# Required, not defensive. 02_prerequisites.sh.j2 applies `chmod -R 600` across
# cluster_manager/, so nothing under it is executable by the time this runs
# whatever mode the repository records. Without this the invocation below fails
# with permission denied and the else branch turns that into a warning, so the
# sidecar would be installed on no cluster and the bootstrap would still report
# success. The overlay block above chmods its own scripts for the same reason.
#
# The `|| log_warning` matters: an unmatched glob leaves the literal `*.sh`, chmod
# exits non-zero, and this line sits OUTSIDE the `if` that makes a missing sidecar
# non-fatal. This template declares `#!/bin/bash -xe` but is invoked as
# `/bin/bash 03_setup.sh` from 02_prerequisites.sh.j2, which ignores the shebang,
# so errexit is not in effect today and the abort does not happen - but the
# declared intent is errexit, and this line should not be the one that decides
# whether a cluster with no sidecar tree still finishes its bootstrap.
chmod +x /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/mesh_sidecar/*.sh \
    || log_warning "[cross-region] could not make the mesh_sidecar scripts executable; the sidecar will not be installed"
if /opt/edh/{{ context.get("/configuration/ClusterId") }}/cluster_manager/mesh_sidecar/install-mesh-sidecar.sh \
        >>${EDH_BOOTSTRAP_LOGS_FOLDER}/install_mesh_sidecar.log 2>&1; then
    log_info "[cross-region] edh-mesh-sidecar installed"
else
    _edh_sidecar_rc=$?
    log_warning "[cross-region] install-mesh-sidecar.sh exited ${_edh_sidecar_rc}. This cluster's peer-facing mesh routes are not being served, so peers cannot dispatch jobs to it; nothing else about the cluster is affected. See ${EDH_BOOTSTRAP_LOGS_FOLDER}/install_mesh_sidecar.log for the cause. It is idempotent and reads its inputs from /etc/environment, so it can be re-run directly as root: /opt/edh/{{ context.get('/configuration/ClusterId') }}/cluster_manager/mesh_sidecar/install-mesh-sidecar.sh"
fi
{% endif %}

# Install OpenMPI
{% include "templates/linux/openmpi.sh.j2" %}

