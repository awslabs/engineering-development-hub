{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Action": [
                "pricing:GetProducts",
                "budgets:ViewBudget",
                "batch:DescribeJobQueues",
                "batch:DescribeJobs",
                "batch:DescribeJobDefinitions",
                "batch:DescribeComputeEnvironments",
                "batch:ListJobs",
                "batch:ListJobsByConsumableResource",
                "batch:ListConsumableResources",
                "batch:ListServiceJobs",
                "batch:DescribeServiceJob",
                "batch:ListTagsForResource",
                "bedrock:ListAgents",
                "bedrock-agentcore:ListAgentRuntimes",
                "bedrock-agentcore:ListTagsForResource",
                "pcs:GetCluster",
                "pcs:ListClusters",
                "pcs:ListQueues",
                "pcs:ListComputeNodeGroups",
                "pcs:ListTagsForResource",
                "pcs:GetComputeNodeGroup",
                "pcs:GetQueue",
                "ec2:CreateFleet",
                "ec2:DescribeFleet*",
                "ec2:DeleteFleets",
                "ec2:DescribeInstances",
                "ec2:DescribeSubnets",
                "ec2:DescribeSecurityGroups",
                "ec2:GetSecurityGroupsForVpc",
                "ec2:DescribeImages",
                "ec2:DescribeSnapshots",
                "ec2:DescribeInstanceAttribute",
                "ec2:DescribeInstanceTypes",
                "ec2:DescribeInstanceStatus",
                "ec2:DescribeCapacityReservations",
                "ec2:DescribeReservedInstances",
                "ec2:DescribeSpotInstanceRequests",
                "ec2:DescribeVpcClassicLink",
                "ec2:DescribeVolumes",
                "ec2:DescribePlacementGroups",
                "ec2:DescribeKeyPairs",
                "ec2:DescribeLaunchTemplates",
                "ec2:DescribeInstanceTypeOfferings",
                "ec2:DescribeLaunchTemplateVersions",
                "elasticfilesystem:DescribeAccessPoints",
                "ec2:DescribeNetworkInterfaces",
                "ec2:DescribeSpotFleetRequests",
                "ec2:DescribeSpotFleetInstances",
                "ec2:DescribeSpotFleetRequestHistory",
                "ec2:ModifyFleet",
                "ec2:ModifyInstancePlacement",
                "elasticfilesystem:DescribeMountTargets",
                "logs:FilterLogEvents",
                "fsx:DescribeFileSystems",
                "fsx:DescribeVolumes",
                "fsx:DescribeStorageVirtualMachines",
                "fsx:ListTagsForResource",
                "iam:GetInstanceProfile",
                "autoscaling:DescribeAutoScalingGroups",
                "autoscaling:DescribeScalingActivities",
                "autoscaling:DescribeLaunchConfigurations",
                "autoscaling:DescribeWarmPool",
                "elasticloadbalancing:DescribeRules",
                "elasticloadbalancing:DescribeListeners",
                "elasticloadbalancing:DescribeTargetGroups",
                "savingsplans:DescribeSavingsPlans",
                "servicequotas:ListServiceQuotas",
                "ssm:ListDocuments",
                "ssm:ListDocumentVersions",
                "ssm:DescribeDocument",
                "ssm:GetDocument",
                "ssm:DescribeInstanceInformation",
                "ssm:DescribeDocumentParameters",
                "ssm:DescribeInstanceProperties",
                "ssm:ListCommands",
                "ssm:GetCommandInvocation",
                "ssm:DescribeAutomationExecutions",
                "iam:ListInstanceProfiles"
            ],
            "Resource": "*",
            "Effect": "Allow"
        },
        {
            "Sid": "BedrockInferenceProfileResolve",
            "Action": [
                "bedrock:GetInferenceProfile"
            ],
            "Resource": "arn:%%AWS_PARTITION%%:bedrock:%%AWS_REGION%%:%%AWS_ACCOUNT_ID%%:inference-profile/*",
            "Effect": "Allow"
        },
        {
            "Sid": "FSxOntapCreateAndTag",
            "Action": [
                "fsx:CreateStorageVirtualMachine",
                "fsx:CreateVolume",
                "fsx:TagResource"
            ],
            "Resource": [
                "arn:%%AWS_PARTITION%%:fsx:%%AWS_REGION%%:%%AWS_ACCOUNT_ID%%:file-system/*",
                "arn:%%AWS_PARTITION%%:fsx:%%AWS_REGION%%:%%AWS_ACCOUNT_ID%%:storage-virtual-machine/*",
                "arn:%%AWS_PARTITION%%:fsx:%%AWS_REGION%%:%%AWS_ACCOUNT_ID%%:volume/*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:RequestTag/edh:ClusterId": "%%CLUSTER_ID%%"
                }
            },
            "Effect": "Allow"
        },
        {
            "Sid": "FSxOntapSvmUpdate",
            "Action": [
                "fsx:UpdateStorageVirtualMachine"
            ],
            "Resource": [
                "arn:%%AWS_PARTITION%%:fsx:%%AWS_REGION%%:%%AWS_ACCOUNT_ID%%:storage-virtual-machine/*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/edh:ClusterId": "%%CLUSTER_ID%%"
                }
            },
            "Effect": "Allow"
        }
    ]
}
