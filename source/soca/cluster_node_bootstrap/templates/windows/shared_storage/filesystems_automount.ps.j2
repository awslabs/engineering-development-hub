# Begin - SOCA Windows Shared Storage Auto-Mount (FSx for NetApp ONTAP / CIFS)
#
# Reads the CIFS endpoint from /configuration/FileSystems/<fs> in SSM:
#   - smb_dns         : SMB endpoint FQDN -- published by the controller from the FSx API
#                       (see mount_fsx_ontap.sh.j2)
#   - cifs_share_name : the share name -- set by the admin via 'edhctl filesystems'
#                       (ONTAP share names are not always derivable from the junction path)
# This template makes NO FSx API calls -- everything it needs is already in SSM.
#
# For each fsx_ontap filesystem that has a non-empty mount_drive_letter, it installs
# a per-user AtLogOn scheduled task that maps the drive under the logging-on user's
# OWN Kerberos identity, so ownership/ACLs resolve correctly via the SVM win<->unix
# name-mapping created controller-side by fsx_ontap_first_setup. The CIFS share itself
# is created controller-side; this only maps it.
#
# Best-effort: a failure here NEVER blocks user logon.

function Install-SOCASharedDriveMappings {

    $ClusterId = "{{ context.get('/configuration/ClusterId') }}"
    $SsmPrefix = "/edh/${ClusterId}/configuration/FileSystems"
    $SocaDir   = "C:\ProgramData\soca"
    $MapScript = Join-Path $SocaDir "Map-SharedDrives.ps1"
    $TaskName  = "SOCAMapSharedDrives"

    Log-Info -message "Resolving FSx ONTAP CIFS drive mappings from ${SsmPrefix} (SSM only, no FSx API calls)"

    $raw = Invoke-SOCAAwsCli ssm get-parameters-by-path --path "${SsmPrefix}" `
            --recursive --with-decryption --query "Parameters" --output json
    if ([string]::IsNullOrWhiteSpace($raw)) {
        Log-Warning -message "FileSystems SSM tree empty under ${SsmPrefix}; no Windows drive mappings to install."
        return
    }
    $params = $raw | ConvertFrom-Json

    # Fold flat SSM keys into per-filesystem dictionaries (e.g. data/provider -> fs['data']['provider'])
    $fs = @{}
    foreach ($p in $params) {
        $rel = $p.Name.Substring($SsmPrefix.Length).TrimStart('/')
        $parts = $rel.Split('/'); if ($parts.Count -lt 2) { continue }
        if (-not $fs.ContainsKey($parts[0])) { $fs[$parts[0]] = @{} }
        $fs[$parts[0]][$parts[1]] = $p.Value
    }

    # Build (DriveLetter, UNC) pairs for qualifying ONTAP filesystems
    $mappings = @()
    foreach ($name in $fs.Keys) {
        $e = $fs[$name]
        if ($e['provider'] -ne 'fsx_ontap') { continue }
        if ([string]::IsNullOrWhiteSpace($e['mount_drive_letter'])) { continue }
        if ($e['enabled'] -eq 'false') { Log-Info -message "Filesystem '${name}' disabled; skipping mapping."; continue }

        $smbDns = $e['smb_dns']
        $share  = $e['cifs_share_name']
        if ([string]::IsNullOrWhiteSpace($smbDns) -or [string]::IsNullOrWhiteSpace($share)) {
            Log-Warning -message "Filesystem '${name}' has mount_drive_letter but is missing smb_dns (controller has not published the SMB endpoint yet) or cifs_share_name (admin has not set the share name); skipping."
            continue
        }

        $drive = $e['mount_drive_letter'].TrimEnd(':').ToUpper() + ":"
        $unc   = "\\${smbDns}\${share}"
        Log-Info -message "Filesystem '${name}': will map ${drive} -> ${unc}"
        $mappings += [pscustomobject]@{ Drive = $drive; Unc = $unc }
    }

    if ($mappings.Count -eq 0) {
        Log-Info -message "No FSx ONTAP filesystems with a mount_drive_letter; ensuring no stale mapping task remains."
        Unregister-ScheduledTask -TaskName $TaskName -Confirm:$false -ErrorAction SilentlyContinue
        return
    }

    # Emit the per-user logon mapping script. Runs in the user's session under their own
    # Kerberos ticket -- never throws, never blocks logon.
    if (-not (Test-Path $SocaDir)) { New-Item -ItemType Directory -Path $SocaDir -Force | Out-Null }
    $lines = @(
        '# Auto-generated by SOCA windows shared_storage automount. Do not edit.',
        '# Maps FSxN CIFS shares at user logon. Best-effort: never throws, never blocks logon.',
        '# A target letter already in use on this instance (local disk, instance-store/scratch,',
        '# CD-ROM, or an existing mapping) is left alone and skipped with a warning.'
    )
    foreach ($m in $mappings) {
        $lines += "try {"
        $lines += "  if (Get-SmbMapping -LocalPath '$($m.Drive)' -ErrorAction SilentlyContinue) {"
        $lines += "    # already mapped (persistent reconnect) -- nothing to do"
        $lines += "  } elseif ([System.IO.DriveInfo]::GetDrives().Name -contains '$($m.Drive)\') {"
        $lines += "    Write-Output `"[WARNING] drive $($m.Drive) already in use on this instance (local/scratch volume); skipping CIFS map to $($m.Unc)`""
        $lines += "  } else {"
        $lines += "    New-SmbMapping -LocalPath '$($m.Drive)' -RemotePath '$($m.Unc)' -Persistent `$true -ErrorAction Stop | Out-Null"
        $lines += "  }"
        $lines += "} catch { Write-Output `"[WARNING] map $($m.Drive) -> $($m.Unc) failed: `$(`$_.Exception.Message)`" }"
    }
    Set-Content -Path $MapScript -Value ($lines -join "`r`n") -Encoding UTF8 -Force
    Log-Info -message "Wrote per-user mapping script ${MapScript} ($($mappings.Count) drive(s))."

    # Register a per-user AtLogOn scheduled task. Principal = BUILTIN\Users (S-1-5-32-545)
    # so the task runs in the context of whichever user logs on (their own token/Kerberos).
    if (Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue) {
        Unregister-ScheduledTask -TaskName $TaskName -Confirm:$false
    }
    $action    = New-ScheduledTaskAction -Execute "powershell.exe" `
                 -Argument "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File `"${MapScript}`""
    $trigger   = New-ScheduledTaskTrigger -AtLogOn
    $principal = New-ScheduledTaskPrincipal -GroupId "S-1-5-32-545" -RunLevel Limited
    $settings  = New-ScheduledTaskSettingsSet -StartWhenAvailable
    Register-ScheduledTask -TaskName $TaskName -Action $action -Trigger $trigger `
        -Principal $principal -Settings $settings -Force | Out-Null
    Log-Info -message "Registered per-user logon task '${TaskName}' for SOCA shared-drive mapping."
}

try {
    Install-SOCASharedDriveMappings
} catch {
    Log-Warning -message "Install-SOCASharedDriveMappings failed (non-fatal): $($_.Exception.Message)"
}
# End - SOCA Windows Shared Storage Auto-Mount
