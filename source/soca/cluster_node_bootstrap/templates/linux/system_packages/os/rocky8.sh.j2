{% include "templates/linux/system_packages/os/base_packages/rhel_based_distributions.sh.j2" %}

log_info "Customizing Linux packages installation  for Rocky 8"
dnf config-manager --set-enabled powertools

# Packages not available or with a different name in this distro
REMOVE_PKGS=(
  libselinux-python
  libverto-tevent
  system-lsb
  openldap-compat
  compat-openldap
  lzma
  tcp_wrappers
  python-sssdconfig
)

# New packages to add  (specific to this distro)
ADD_PKGS=(
  python3-libselinux
  python3-sss
  dejavu-fonts-common
  redhat-lsb
  ec2-hibinit-agent
  xz-devel
)

if grep -qE "^exclude=.*kernel" /etc/dnf/dnf.conf /etc/yum.conf 2>/dev/null; then
    log_warning "Kernel packages are excluded via dnf/yum config. Removing kernel packages from install list to preserve current kernel version"
    REMOVE_PKGS+=(kernel kernel-devel kernel-headers)
fi

log_info "Removing packages for Rocky8: ${REMOVE_PKGS[*]}"
log_info "Adding extra packages for Rocky8: ${ADD_PKGS[*]}"