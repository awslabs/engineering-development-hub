# Begin: Install AWS SSM agent
function install_ssm_agent () {
  log_info "# Begin: Install AWS SSM agent"
  local MACHINE=$(uname -m)
  {% if context.get("/job/BaseOS") in ("ubuntu2204", "ubuntu2404") %}
    if ! snap list amazon-ssm-agent; then
      snap install amazon-ssm-agent --classic
      snap enable amazon-ssm-agent
      snap restart amazon-ssm-agent
    fi

   {% else %}
    if ! systemctl status amazon-ssm-agent; then
        if [[ ${MACHINE} == "x86_64" ]]; then
            file_download --download-url="{{ context.get("/system/ssm/x86_64") }}" --save-as="amazon_ssm_agent.rpm"
        elif [[ ${MACHINE} == "aarch64" ]]; then
            file_download --download-url="{{ context.get("/system/ssm/aarch64") }}" --save-as="amazon_ssm_agent.rpm"
        fi
        packages_install_file amazon_ssm_agent.rpm
        
        systemctl enable amazon-ssm-agent || true
        systemctl restart amazon-ssm-agent
    fi
   {% endif %}

  log_info "# End: Install AWS SSM Agent"
}
install_ssm_agent
# End: Install AWS SSM Agent
