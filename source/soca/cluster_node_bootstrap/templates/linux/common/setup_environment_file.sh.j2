# Begin - Setup /etc/environment
function set_environment_variable () {
  local VARIABLE_NAME=${1}
  local VARIABLE_VALUE=${2}
  local SOCA_IDENTIFIER="# SOCA Environment Variable, [SOCA_DO_NOT_DELETE]" # added to each entry

  if [[ -z ${VARIABLE_NAME} ]]; then
    exit_fail "set_environment_variable. VARIABLE_NAME (first argument) not found"
  fi
  if [[ -z ${VARIABLE_VALUE} ]]; then
    exit_fail "set_environment_variable. VARIABLE_VALUE (second argument) not found"
  fi

  # Quote the value properly
  local QUOTED_VALUE
  QUOTED_VALUE=$(printf '%q' "$VARIABLE_VALUE")  # safely quotes spaces and special chars

  log_info "Setting ${VARIABLE_NAME}=${QUOTED_VALUE} to /etc/environment"

  if grep -q "^[^#]*${VARIABLE_NAME}=" /etc/environment; then
      log_info "${VARIABLE_NAME}= found but not pointing to ${QUOTED_VALUE}, remove the line ... "
      sed -i "/^[^#]*${VARIABLE_NAME}=/d" /etc/environment
  fi

  log_info "Adding ${VARIABLE_NAME}=${QUOTED_VALUE} to /etc/environment"
  # /etc/environment is read by pam_env as plain KEY=value lines; it does NOT
  # support the 'export' keyword (pam_env would treat "export FOO" as the name).
  # Write a bare assignment so pam_env parses it cleanly.
  {
    printf "%s\n%s=%s\n" "$SOCA_IDENTIFIER" "$VARIABLE_NAME" "$QUOTED_VALUE"
  } >> /etc/environment

  # Bare lines are not auto-exported when sourced, so export into the running shell
  export "${VARIABLE_NAME}=${VARIABLE_VALUE}"
}

function set_environment_command () {
  local COMMAND=${1}
  local SOCA_IDENTIFIER="# SOCA Environment Command, [SOCA_DO_NOT_DELETE]" # added to each entry

  if [[ -z ${COMMAND} ]]; then
    exit_fail "set_environment_command. COMMAND (first argument) not found"
  fi

  log_info "Setting ${COMMAND} to /etc/environment"
  if grep -q "^[^#]*${COMMAND}" /etc/environment; then
      log_info "${COMMAND}already found in  /etc/environment, ignoring ..."
  else
      log_info "Adding ${COMMAND} to /etc/environment"
      {
        printf "${SOCA_IDENTIFIER}\n${COMMAND}\n"
      } >> /etc/environment
  fi
  # Reload your env
  source /etc/environment
}
# End - Setup /etc/environment