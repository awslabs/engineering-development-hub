# Begin: Apply password policy settings to AWS Managed AD PSO

function apply_ad_password_policy {
  {% if not context.get("/configuration/UserDirectory/password_policy/enabled", true) %}
  log_info "Password policy updates disabled by configuration, skipping."
  return 0
  {% endif %}
  local DS_DOMAIN_NAME="{{ context.get("/configuration/UserDirectory/domain_name") }}"
  local DS_DOMAIN_DN=$(echo "${DS_DOMAIN_NAME}" | sed 's/\./,DC=/g' | sed 's/^/DC=/')
  local PSO_NAME="{{ context.get("/configuration/UserDirectory/password_policy/pso_name", "CustomerPSO-01") }}"
  local PSO_DN="CN=${PSO_NAME},CN=Password Settings Container,CN=System,${DS_DOMAIN_DN}"
  local AD_CACHE="/apps/edh/{{ context.get("/configuration/ClusterId") }}/shared/custom_automation/ad_automation"
  local DS_DOMAIN_ADMIN_USERNAME=$(cat "${AD_CACHE}/join_domain_user.cache")
  local DS_DOMAIN_ADMIN_PASSWORD_FILE="${AD_CACHE}/join_domain.cache"

  log_info "Using creds for bind user: ${DS_DOMAIN_ADMIN_USERNAME}"
  log_info "Target PSO: ${PSO_DN}"

  # Pin every LDAP operation in this function to a single domain controller.
  # "${DS_DOMAIN_NAME}" round-robins across all DCs, so a modify on one DC and a
  # read-back on another can race AD replication. Resolving one DC up front and
  # reusing it gives read-your-writes consistency. Simple binds (-x) mean binding
  # to a DC IP has no SASL/SPN hostname requirement. Falls back to the domain
  # name (previous round-robin behavior) if resolution yields nothing.
  local DS_DC_HOST
  DS_DC_HOST=$(getent hosts "${DS_DOMAIN_NAME}" 2>/dev/null | awk '{print $1; exit}')
  if [[ -z "${DS_DC_HOST}" ]]; then
    DS_DC_HOST="${DS_DOMAIN_NAME}"
    log_warning "Could not resolve a single DC for ${DS_DOMAIN_NAME}; falling back to domain round-robin."
  else
    log_info "Pinned LDAP operations to DC ${DS_DC_HOST}"
  fi
  local DS_LDAP_URI="ldap://${DS_DC_HOST}"

  # Log configured values from context
  {% set attr_map = [
    ("max_password_age_days", "msDS-MaximumPasswordAge", 0, "days"),
    ("min_password_age_days", "msDS-MinimumPasswordAge", 1, "days"),
    ("min_password_length", "msDS-MinimumPasswordLength", 7, "int"),
    ("password_history_length", "msDS-PasswordHistoryLength", 24, "int"),
    ("lockout_threshold", "msDS-LockoutThreshold", 0, "int"),
    ("lockout_duration_minutes", "msDS-LockoutDuration", 30, "minutes"),
    ("lockout_observation_window_minutes", "msDS-LockoutObservationWindow", 30, "minutes"),
    ("complexity_enabled", "msDS-PasswordComplexityEnabled", true, "bool"),
    ("reversible_encryption", "msDS-PasswordReversibleEncryptionEnabled", false, "bool")
  ] %}
  {% for key, ldap_attr, default_val, unit in attr_map %}
  log_info "  Config: {{ key }} = {{ context.get("/configuration/UserDirectory/password_policy/" ~ key, default_val) }} ({{ unit }}, maps to {{ ldap_attr }})"
  {% endfor %}
  log_info "  Config: max_retries = {{ context.get("/configuration/UserDirectory/password_policy/max_retries", 10) }}"

  # Query current PSO settings before making changes
  log_info "Querying the current PSO settings from LDAP ..."
  local MAX_RETRIES={{ context.get("/configuration/UserDirectory/password_policy/max_retries", 10) }}
  local RETRY_COUNT=0
  local LDAP_QUERY_SUCCESS=false

  while [[ ${RETRY_COUNT} -lt ${MAX_RETRIES} ]]; do
    local QUERY_OUTPUT
    if QUERY_OUTPUT=$(ldapsearch -x -H "${DS_LDAP_URI}" \
      -D "${DS_DOMAIN_ADMIN_USERNAME}" \
      -y "${DS_DOMAIN_ADMIN_PASSWORD_FILE}" \
      -b "${PSO_DN}" -s base "(objectClass=*)" \
      {% for key, ldap_attr, default_val, unit in attr_map %}{{ ldap_attr }} {% endfor %}2>/dev/null)
    then
      echo "${QUERY_OUTPUT}" | grep -i "msDS-" | while read line; do log_info "  Current: ${line}"; done
      LDAP_QUERY_SUCCESS=true
      break
    else
      RETRY_COUNT=$((RETRY_COUNT + 1))
      local BACKOFF=$(( 2 ** RETRY_COUNT > 60 ? 60 : 2 ** RETRY_COUNT ))
      if [[ ${RETRY_COUNT} -lt ${MAX_RETRIES} ]]; then
        log_warning "ldapsearch failed (attempt ${RETRY_COUNT}/${MAX_RETRIES}), retrying in ${BACKOFF}s ..."
        sleep ${BACKOFF}
      fi
    fi
  done

  if [[ "${LDAP_QUERY_SUCCESS}" != "true" ]]; then
    log_warning "Unable to query PSO after ${MAX_RETRIES} attempts. LDAP server may be unavailable. Skipping password policy update."
    return 0
  fi

  # Build LDIF dynamically from password_policy config
  local LDIF_FILE=$(mktemp /root/edh_ad_pso_update.XXXXXX.ldif)
  echo "dn: ${PSO_DN}" > "${LDIF_FILE}"
  echo "changetype: modify" >> "${LDIF_FILE}"

  local ATTR_COUNT=0

  # Tuple format: (yaml_key, ldap_attribute, default_value, unit)
  # Zero handling: max_password_age_days=0 means never expires (I64_MIN)
  #                all other time fields: 0 passes through as 0 (disabled/immediate)
  {% set ns = namespace(first=true) %}
  {% for key, ldap_attr, default_val, unit in attr_map %}
  {% set val = context.get("/configuration/UserDirectory/password_policy/" ~ key, default_val) %}
  {% set val = val | int if unit in ("days", "minutes", "int") else val %}
  {% if not ns.first %}
  echo "-" >> "${LDIF_FILE}"
  {% endif %}
  {% set ns.first = false %}
  echo "replace: {{ ldap_attr }}" >> "${LDIF_FILE}"
  {% if unit == "bool" %}
  echo "{{ ldap_attr }}: {{ "TRUE" if val else "FALSE" }}" >> "${LDIF_FILE}"
  {% elif unit == "days" %}
  {% if key == "max_password_age_days" and val == 0 %}
  echo "{{ ldap_attr }}: -9223372036854775808" >> "${LDIF_FILE}"
  {% elif val == 0 %}
  echo "{{ ldap_attr }}: 0" >> "${LDIF_FILE}"
  {% else %}
  echo "{{ ldap_attr }}: {{ val * -864000000000 }}" >> "${LDIF_FILE}"
  {% endif %}
  {% elif unit == "minutes" %}
  {% if val == 0 %}
  echo "{{ ldap_attr }}: 0" >> "${LDIF_FILE}"
  {% else %}
  echo "{{ ldap_attr }}: {{ val * -600000000 }}" >> "${LDIF_FILE}"
  {% endif %}
  {% else %}
  echo "{{ ldap_attr }}: {{ val }}" >> "${LDIF_FILE}"
  {% endif %}
  ATTR_COUNT=$((ATTR_COUNT + 1))
  {% endfor %}

  log_info "Applying password policy (${ATTR_COUNT} attributes) to PSO: ${PSO_NAME}"
  log_info "Full LDIF content:"
  cat "${LDIF_FILE}" | while read line; do log_info "  ${line}"; done

  # Apply LDIF with retry
  RETRY_COUNT=0
  local LDAP_MODIFY_SUCCESS=false

  while [[ ${RETRY_COUNT} -lt ${MAX_RETRIES} ]]; do
    if ldapmodify -x -H "${DS_LDAP_URI}" \
      -D "${DS_DOMAIN_ADMIN_USERNAME}" \
      -y "${DS_DOMAIN_ADMIN_PASSWORD_FILE}" \
      -f "${LDIF_FILE}"
    then
      LDAP_MODIFY_SUCCESS=true
      break
    else
      RETRY_COUNT=$((RETRY_COUNT + 1))
      local BACKOFF=$(( 2 ** RETRY_COUNT > 60 ? 60 : 2 ** RETRY_COUNT ))
      if [[ ${RETRY_COUNT} -lt ${MAX_RETRIES} ]]; then
        log_warning "ldapmodify failed (attempt ${RETRY_COUNT}/${MAX_RETRIES}), retrying in ${BACKOFF}s ..."
        sleep ${BACKOFF}
      fi
    fi
  done

  if [[ "${LDAP_MODIFY_SUCCESS}" == "true" ]]; then
    log_info "Password policy applied to ${PSO_NAME}; verifying values replicated on ${DS_DC_HOST} (polling up to 120s)..."
    # Assert the values we just wrote are visible on the same DC. Expected
    # "attr: value" lines come straight from the applied LDIF, so no value logic
    # is duplicated. Bounded to 120s; non-convergence is non-fatal (the
    # ldapmodify already returned success above).
    local V_EXPECTED V_WAITED=0 V_MISSING=0 V_OK=false VERIFY_OUTPUT V_LINE
    V_EXPECTED=$(grep -E '^msDS-[^:]+: ' "${LDIF_FILE}")
    while true; do
      VERIFY_OUTPUT=$(ldapsearch -x -LLL -o ldif-wrap=no -H "${DS_LDAP_URI}" \
        -D "${DS_DOMAIN_ADMIN_USERNAME}" \
        -y "${DS_DOMAIN_ADMIN_PASSWORD_FILE}" \
        -b "${PSO_DN}" -s base "(objectClass=*)" \
        {% for key, ldap_attr, default_val, unit in attr_map %}{{ ldap_attr }} {% endfor %}2>/dev/null) || true
      V_MISSING=0
      while IFS= read -r V_LINE; do
        [[ -z "${V_LINE}" ]] && continue
        grep -Fixq -- "${V_LINE}" <<< "${VERIFY_OUTPUT}" || V_MISSING=$((V_MISSING + 1))
      done <<< "${V_EXPECTED}"
      if [[ ${V_MISSING} -eq 0 ]]; then
        V_OK=true
        break
      fi
      if [[ ${V_WAITED} -ge 120 ]]; then
        break
      fi
      log_info "  ${V_MISSING} attribute value(s) not yet visible on ${DS_DC_HOST}; re-checking in 5s (waited ${V_WAITED}s of 120s)..."
      sleep 5
      V_WAITED=$((V_WAITED + 5))
    done
    echo "${VERIFY_OUTPUT}" | grep -i "msDS-" | while read line; do log_info "  Current: ${line}"; done
    if [[ "${V_OK}" == "true" ]]; then
      log_info "Verified: all password-policy attributes present on ${PSO_NAME} at ${DS_DC_HOST} (after ${V_WAITED}s)."
    else
      log_warning "Password policy on ${PSO_NAME}: ${V_MISSING} attribute value(s) still not visible on ${DS_DC_HOST} after 120s. The ldapmodify already returned success, so this is a replication/visibility lag only -- continuing bootstrap (non-fatal)."
    fi
    # Cleanup the LDIF file now that verification has run
    rm -f "${LDIF_FILE}"
  else
    log_warning "Failed to apply password policy to ${PSO_NAME} after ${MAX_RETRIES} attempts. This is non-fatal, continuing bootstrap. LDIF retained at ${LDIF_FILE}"
  fi

  # Begin: Link PSO to target group(s) via msDS-PSOAppliesTo.
  # Idempotent: resolves each configured group by sAMAccountName and uses a
  # 'replace' so the configured set is authoritative on every bootstrap.
  # pso_applies_to is a COMMA-delimited scalar string (not a YAML list): the
  # installer's config flattener space-joins YAML lists into one SSM value,
  # which is ambiguous for group names that contain spaces (e.g. "Domain
  # Users"). Splitting on comma and trimming lets space-containing names and
  # multiple groups coexist. Empty string leaves msDS-PSOAppliesTo unmanaged.
  {% set _pso_applies_to = context.get("/configuration/UserDirectory/password_policy/pso_applies_to", "Domain Users") %}
  {% if _pso_applies_to is not string %}{% set _pso_applies_to = _pso_applies_to | join(",") %}{% endif %}
  local PSO_APPLIES_TO_RAW="{{ _pso_applies_to }}"
  local PSO_APPLIES_TO=()
  local _PSO_RAW_ARR _pso_grp
  IFS=',' read -r -a _PSO_RAW_ARR <<< "${PSO_APPLIES_TO_RAW}"
  for _pso_grp in "${_PSO_RAW_ARR[@]}"; do
    _pso_grp="$(echo "${_pso_grp}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [[ -n "${_pso_grp}" ]] && PSO_APPLIES_TO+=("${_pso_grp}")
  done

  if [[ -z "${PSO_APPLIES_TO[*]}" ]]; then
    log_info "pso_applies_to is empty; leaving msDS-PSOAppliesTo unmanaged for ${PSO_NAME}."
  else
    log_info "Resolving group(s) to link to PSO ${PSO_NAME}: ${PSO_APPLIES_TO[*]}"
    local RESOLVED_DNS=()
    local RESOLVE_FAILED=false
    local GRP GRP_DN
    for GRP in "${PSO_APPLIES_TO[@]}"; do
      GRP_DN=$(ldapsearch -x -LLL -o ldif-wrap=no -H "${DS_LDAP_URI}" \
        -D "${DS_DOMAIN_ADMIN_USERNAME}" \
        -y "${DS_DOMAIN_ADMIN_PASSWORD_FILE}" \
        -b "${DS_DOMAIN_DN}" "(&(objectClass=group)(sAMAccountName=${GRP}))" \
        distinguishedName 2>/dev/null | grep -i "^distinguishedName:" | sed 's/^distinguishedName: //I' | head -1)
      if [[ -n "${GRP_DN}" ]]; then
        log_info "  Resolved group '${GRP}' -> ${GRP_DN}"
        RESOLVED_DNS+=("${GRP_DN}")
      else
        log_warning "  Could not resolve group '${GRP}' to a DN under ${DS_DOMAIN_DN}"
        RESOLVE_FAILED=true
      fi
    done

    if [[ "${RESOLVE_FAILED}" == "true" || -z "${RESOLVED_DNS[*]}" ]]; then
      log_warning "Not all pso_applies_to groups resolved; skipping msDS-PSOAppliesTo update to avoid clobbering existing scope. PSO ${PSO_NAME} link left unchanged."
    else
      local PSO_LINK_LDIF=$(mktemp /root/edh_ad_pso_link.XXXXXX.ldif)
      echo "dn: ${PSO_DN}" > "${PSO_LINK_LDIF}"
      echo "changetype: modify" >> "${PSO_LINK_LDIF}"
      echo "replace: msDS-PSOAppliesTo" >> "${PSO_LINK_LDIF}"
      for GRP_DN in "${RESOLVED_DNS[@]}"; do
        echo "msDS-PSOAppliesTo: ${GRP_DN}" >> "${PSO_LINK_LDIF}"
      done
      log_info "PSO applies-to LDIF:"
      cat "${PSO_LINK_LDIF}" | while read line; do log_info "  ${line}"; done

      RETRY_COUNT=0
      local PSO_LINK_SUCCESS=false
      while [[ ${RETRY_COUNT} -lt ${MAX_RETRIES} ]]; do
        if ldapmodify -x -H "${DS_LDAP_URI}" \
          -D "${DS_DOMAIN_ADMIN_USERNAME}" \
          -y "${DS_DOMAIN_ADMIN_PASSWORD_FILE}" \
          -f "${PSO_LINK_LDIF}"
        then
          PSO_LINK_SUCCESS=true
          break
        else
          RETRY_COUNT=$((RETRY_COUNT + 1))
          local BACKOFF=$(( 2 ** RETRY_COUNT > 60 ? 60 : 2 ** RETRY_COUNT ))
          if [[ ${RETRY_COUNT} -lt ${MAX_RETRIES} ]]; then
            log_warning "ldapmodify (PSO link) failed (attempt ${RETRY_COUNT}/${MAX_RETRIES}), retrying in ${BACKOFF}s ..."
            sleep ${BACKOFF}
          fi
        fi
      done

      if [[ "${PSO_LINK_SUCCESS}" == "true" ]]; then
        log_info "Linked PSO ${PSO_NAME} to: ${RESOLVED_DNS[*]}"
        log_info "Verifying msDS-PSOAppliesTo replicated on ${DS_DC_HOST} (polling up to 120s)..."
        # Assert every DN we set is visible on the same DC. Bounded to 120s;
        # non-convergence is non-fatal (the ldapmodify already succeeded above).
        local LV_WAITED=0 LV_MISSING=0 LV_OK=false LINK_VERIFY LV_DN
        while true; do
          LINK_VERIFY=$(ldapsearch -x -LLL -o ldif-wrap=no -H "${DS_LDAP_URI}" \
            -D "${DS_DOMAIN_ADMIN_USERNAME}" \
            -y "${DS_DOMAIN_ADMIN_PASSWORD_FILE}" \
            -b "${PSO_DN}" -s base "(objectClass=*)" msDS-PSOAppliesTo 2>/dev/null) || true
          LV_MISSING=0
          for LV_DN in "${RESOLVED_DNS[@]}"; do
            grep -Fixq -- "msDS-PSOAppliesTo: ${LV_DN}" <<< "${LINK_VERIFY}" || LV_MISSING=$((LV_MISSING + 1))
          done
          if [[ ${LV_MISSING} -eq 0 ]]; then
            LV_OK=true
            break
          fi
          if [[ ${LV_WAITED} -ge 120 ]]; then
            break
          fi
          log_info "  ${LV_MISSING} link value(s) not yet visible on ${DS_DC_HOST}; re-checking in 5s (waited ${LV_WAITED}s of 120s)..."
          sleep 5
          LV_WAITED=$((LV_WAITED + 5))
        done
        echo "${LINK_VERIFY}" | grep -i "msDS-PSOAppliesTo" | while read line; do log_info "  Current: ${line}"; done
        if [[ "${LV_OK}" == "true" ]]; then
          log_info "Verified: PSO ${PSO_NAME} now applies to all target group(s) on ${DS_DC_HOST} (after ${LV_WAITED}s): ${RESOLVED_DNS[*]}"
        else
          log_warning "PSO ${PSO_NAME} link: ${LV_MISSING} target DN(s) still not visible on ${DS_DC_HOST} after 120s. The ldapmodify already returned success, so this is a replication/visibility lag only -- continuing bootstrap (non-fatal)."
        fi
        rm -f "${PSO_LINK_LDIF}"
      else
        log_warning "Failed to link PSO ${PSO_NAME} to target group(s) after ${MAX_RETRIES} attempts. Non-fatal, continuing bootstrap. LDIF retained at ${PSO_LINK_LDIF}"
      fi
    fi
  fi
  # End: Link PSO to target group(s) via msDS-PSOAppliesTo


}

# Now exec it
apply_ad_password_policy

# End: Apply password policy settings to AWS Managed AD PSO
