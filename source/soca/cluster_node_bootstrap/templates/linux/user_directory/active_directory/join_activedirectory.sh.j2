# Begin: Join Active Directory


# Disable automatic node AD Domain Join (use local user synchronization instead) per node type:
#   ephemeral HPC compute nodes:
#     edhctl config set --key "/configuration/FeatureFlags/Hpc/JoinEphemeralNodesToAD" --value "false"
#
# Always-on nodes are governed by their own flag, which defaults to TRUE:
# edhctl config set --key "/configuration/FeatureFlags/Hpc/JoinAlwaysOnNodesToAD" --value "false"
#
# The condition below reads /job/JoinNodeToAD, which cloudformation_builder.py
# resolves from whichever of those two flags applies to this node's queue. Do not
# re-derive it from the flags here: the queue-dependent rule belongs in one place.
# A missing key defaults to True (join), so a node type that never sets it does
# not silently fall into the local-user dump.
#   PCS compute nodes:
#     edhctl config set --key "/configuration/FeatureFlags/Hpc/JoinPCSNodesToAD" --value "false"
# The two flags are independent so enabling/disabling one does not affect the other.

# Note: This is an experimental feature
{# Local-user-sync mode (no AD realm join). Applies to:                                    #}
{#   - ephemeral HPC compute nodes when JoinEphemeralNodesToAD is disabled                 #}
{#   - PCS compute nodes         when JoinPCSNodesToAD        is disabled                   #}
{# Anything else (flag enabled, or the controller) falls through to the realm-join path.   #}

{% if (context.get("/job/NodeType") == "compute_node" and not context.get("/job/JoinNodeToAD", True)) or (context.get("/job/NodeType") == "pcs_node" and not context.get("/configuration/FeatureFlags/Hpc/JoinPCSNodesToAD")) %}
  function sync_ad_users_locally {
    local LOCAL_SOCA_AD_SCRIPT="/opt/edh/{{ context.get("/configuration/ClusterId") }}/sync_ad_users_locally.sh"
    {% if context.get("/job/NodeType") == "pcs_node" %}
    local USERS_TO_SYNC=""  # PCS nodes are shared, long-lived capacity not tied to one job owner: sync ALL SOCA users.
    {% else %}
    if [[ "${EDH_JOB_QUEUE_IS_ALWAYSON}" == "1" ]]; then
        local USERS_TO_SYNC=""  # sync all users in alwayson nodes; please note this can cause some slowness if you have a large number of users
    else
        local USERS_TO_SYNC="${EDH_JOB_OWNER}"  # Only sync job owner. Empty string would sync ALL SOCA users (slow on large directories).
    fi
    {% endif %}
    log_info "Creating local user for ephemeral HPC due to no AD join. User info ${LOCAL_SOCA_AD_USERS}"

    log_info "Writing local SOCA AD script to ${LOCAL_SOCA_AD_SCRIPT}"
    cat > "$LOCAL_SOCA_AD_SCRIPT" <<'EOF'
{% include "templates/linux/user_directory/active_directory/sync_ad_users_locally.sh.j2" %}
EOF

    log_info "Making ${LOCAL_SOCA_AD_SCRIPT} executable"
    chmod +x ${LOCAL_SOCA_AD_SCRIPT}

    log_info "Executing script to sync ${USERS_TO_SYNC} locally ...."
    if ! ${LOCAL_SOCA_AD_SCRIPT} ${USERS_TO_SYNC}; then
        exit_fail "Unable to sync ${USERS_TO_SYNC}  user locally"
    else
        log_info "AD users synced locally, checking /etc/passwd"
        cat /etc/passwd
        log_info "AD users synced locally, checking /etc/group"
        cat /etc/group
    fi

    log_info "configuring ${LOCAL_SOCA_AD_SCRIPT} as recurring cron on the remote machine"
    # delete crontab if already there and create new one
    ( crontab -l 2>/dev/null | grep -v "${LOCAL_SOCA_AD_SCRIPT}"; \
  echo "*/10 * * * * ${LOCAL_SOCA_AD_SCRIPT} ${USERS_TO_SYNC} >> ${EDH_BOOTSTRAP_LOGS_FOLDER}/sync_ad_users.log 2>&1" \
    ) | crontab -
  }
  sync_ad_users_locally

  # sudoers: grant the admin group sudo on ephemeral nodes (no SSSD/realm).
  # Do NOT lowercase: groupadd preserves case, so the local group carries the
  # directory's exact casing. Resolve the real group via getent so the rule
  # matches what sync_ad_users_locally created (also covers spaces and the
  # 32-char groupadd cap: an uncreatable name never resolves -> warn+skip).
  _ADMIN_GROUP_CN=$(echo "{{ context.get('/configuration/UserDirectory/admins_search_base') }}" | awk -F'[,=]' '{print $2}')
  if [[ -z "${_ADMIN_GROUP_CN}" ]]; then
    log_warning "Unable to determine admin group from admins_search_base, skipping sudoers drop-in"
  else
    _ADMIN_GROUP=$(getent group | awk -F: -v want="${_ADMIN_GROUP_CN}" 'tolower($1)==tolower(want){print $1; exit}')
    if [[ -z "${_ADMIN_GROUP}" ]]; then
      log_warning "Admin group '${_ADMIN_GROUP_CN}' not found in /etc/group (not synced, or exceeds the 32-char group name limit); skipping sudoers drop-in"
    else
      _ESCAPED_ADMIN_GROUP=$(echo "${_ADMIN_GROUP}" | sed 's/ /\\ /g')
      _SUDOERS_ENTRY="%${_ESCAPED_ADMIN_GROUP} ALL=(ALL:ALL) NOPASSWD:ALL"
      echo "${_SUDOERS_ENTRY}" > /etc/sudoers.d/edh-admins
      chmod 440 /etc/sudoers.d/edh-admins
      if ! visudo -c -f /etc/sudoers.d/edh-admins >/dev/null 2>&1; then
        log_warning "sudoers syntax check failed for /etc/sudoers.d/edh-admins, removing"
        rm -f /etc/sudoers.d/edh-admins
      fi
    fi
  fi

{% else %}
  function join_ad {
    log_info "Trying to join Active Directory ... "

    if ! verify_package_installed adcli; then
      log_info "adcli is not installed, installing it ... "
      packages_install adcli
    fi

    if ! verify_package_installed realmd; then
      log_info "realm is not installed, installing it ... "
      packages_install realmd
    fi

    {% include "templates/linux/patch_krb5.sh.j2" %}

    local DS_DOMAIN_NAME="{{ context.get("/configuration/UserDirectory/domain_name") }}"
    local UPPER_DS_DOMAIN_NAME="{{ context.get("/configuration/UserDirectory/domain_name") | upper }}"
    local SOCA_DIRECTORY_ADMINS_SEARCH_BASE="{{ context.get("/configuration/UserDirectory/admins_search_base") | lower }}"
    local SOCA_DIRECTORY_ADMIN_GROUP_NAME=$(echo ${SOCA_DIRECTORY_ADMINS_SEARCH_BASE} | awk -F'[,=]' '{print $2}')
    local ESCAPED_SOCA_DIRECTORY_ADMIN_GROUP_NAME=$(echo ${SOCA_DIRECTORY_ADMIN_GROUP_NAME} | sed 's/ /\\ /g') # "My Group" will become "My\ Group"
    local SKIP_AD_JOIN="false" # will be changed to True if the AMI is already joined to the domain
    local DS_DOMAIN_ADMIN_USERNAME
    local DS_DOMAIN_ADMIN_PASSWORD
    local ADCLI=$(command -v adcli)
    local REALM=$(command -v realm)
    local AWS_INSTANCE_ID=$(instance_id)

    log_info "Active Directory Domain Name: ${DS_DOMAIN_NAME}"

    log_info "Verifying if  AD is reachable from the node"
    # Helper: emit a bootstrap-status event if the publisher is loaded
    # (compute_node bootstraps source it; controller bootstrap does not).
    # Silent no-op everywhere else so this script stays portable.
    _ad_emit_status() {
      command -v edh_dcv_publish_event >/dev/null 2>&1 || return 0
      edh_dcv_publish_event "bootstrap-status" "" "$1" || true
    }
    _ad_emit_status "Active Directory: discovering ${DS_DOMAIN_NAME}"
{% if context.get("/job/BaseOS") in ["amazonlinux2027"] %}
    # 'realm discover' resolves SRV through libresolv and bypasses nsswitch, while the join,
    # adcli, sssd and Kerberos use getaddrinfo() and traverse it. A resolver that refuses the
    # domain by policy therefore makes discovery succeed while everything downstream fails.
    # systemd-resolved does this to .local (RFC 6762 reserves it for mDNS) and answers with a
    # definitive error rather than UNAVAIL, so nsswitch never falls through to dns. Add any
    # other base OS that shows this to the gate above.
    _ad_resolver_can_resolve() { getent hosts "$1" >/dev/null 2>&1; }

    # Tests an SRV TARGET, not just the bare domain: the SRV records point at DC hostnames
    # which are themselves .<domain> names, and Kerberos resolves those through getaddrinfo()
    # as well. A resolvable bare domain alone still fails the join.
    _ad_resolver_ready() {
      local _domain="$1" _tool _target
      _tool=$(command -v dig || true)
      if [[ -n "${_tool}" ]]; then
        _target=$("${_tool}" +short SRV "_ldap._tcp.${_domain}" 2>/dev/null | awk 'NR==1{sub(/\.$/,"",$4); print $4}')
        if [[ -n "${_target}" ]]; then
          _ad_resolver_can_resolve "${_target}" || return 1
        fi
      fi
      _ad_resolver_can_resolve "${_domain}"
    }

    # Returns 0 only when it CHANGED something, so the caller can retest without sleeping and
    # a domain that already resolves cannot drive a sleepless loop.
    _ad_fix_resolver_policy() {
      local _domain="$1"
      _ad_resolver_ready "${_domain}" && return 1   # nothing to fix

      systemctl is-active --quiet systemd-resolved 2>/dev/null || return 1

      # The routing domain must go on the LINK: a global one routes to global servers, and the
      # DNS servers here are DHCP-set per-link, so a global drop-in alone is inert. resolvectl
      # replaces the link's domain list, hence reading the existing ones back and restating.
      local _link _existing _servers
      _link=$(ip route show default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
      if [[ -z "${_link}" ]]; then
        log_warning "Could not determine the default-route interface, cannot apply a per-link routing domain for ${_domain}"
        return 1
      fi

      log_warning "${_domain} does not resolve through the system resolver, which is what the AD join and Kerberos use. Adding a routing domain on ${_link}."
      _existing=$(resolvectl domain "${_link}" 2>/dev/null | sed 's/^[^:]*: *//' | tr ' ' '\n' | grep -v "^~\?${_domain}$" | tr '\n' ' ')
      resolvectl domain "${_link}" "~${_domain}" ${_existing} 2>/dev/null \
        || log_warning "resolvectl domain failed on ${_link}"

      # DNS= in the drop-in is what makes this survive the reboot before 03_setup_post_reboot
      _servers=$(resolvectl status "${_link}" 2>/dev/null | awk -F': ' '/DNS Servers/{print $2; exit}')
      mkdir -p /etc/systemd/resolved.conf.d
      {
        printf '# Managed by EDH. Route %s to the DNS servers instead of letting systemd-resolved\n' "${_domain}"
        printf '# refuse it by policy. DNS= is required, a routing domain with no servers is inert.\n'
        printf '[Resolve]\n'
        [[ -n "${_servers}" ]] && printf 'DNS=%s\n' "${_servers}"
        printf 'Domains=~%s\n' "${_domain}"
      } > /etc/systemd/resolved.conf.d/10-edh-ad-domain.conf
      systemctl restart systemd-resolved 2>/dev/null || log_warning "Unable to restart systemd-resolved"
      sleep 2

      # the restart drops runtime per-link settings
      resolvectl domain "${_link}" "~${_domain}" ${_existing} 2>/dev/null || true

      # /etc/nsswitch.conf is left alone: it is authselect managed on some distros
      if _ad_resolver_ready "${_domain}"; then
        log_info "${_domain} and its SRV targets now resolve through the system resolver"
        return 0
      fi
      log_warning "Routing domain applied on ${_link} but ${_domain} still does not resolve through the system resolver"
      return 1
    }

    # both: discovery proves the directory answers, the resolver check proves the join can
    # actually resolve it. Gating on discovery alone logged "is reachable" then failed the join.
    _ad_domain_ready() {
      ${REALM} discover "$1" >/dev/null 2>&1 || return 1
      _ad_resolver_ready "$1"
    }

    _ad_fix_resolver_policy "${DS_DOMAIN_NAME}" || true
    local LOOP_VERIFY_AD_REACHABILITY=0
    while ! _ad_domain_ready "${DS_DOMAIN_NAME}"
      do
        ((LOOP_VERIFY_AD_REACHABILITY++))
        if [[ ${LOOP_VERIFY_AD_REACHABILITY} -ge 30 ]]; then
          # distinguish a resolver split from missing DNS records, so the operator is not sent
          # to investigate records that are present and healthy
          if ${REALM} discover "${DS_DOMAIN_NAME}" >/dev/null 2>&1; then
            _ad_emit_status "AD unreachable: ${DS_DOMAIN_NAME} does not resolve via the system resolver"
            exit_fail "${DS_DOMAIN_NAME} is discoverable over DNS but never resolved through the system resolver, so the AD join cannot succeed. The DNS records are likely fine. Check the resolver policy instead: 'getent hosts ${DS_DOMAIN_NAME}' and 'getent hosts' on an SRV target from 'dig +short SRV _ldap._tcp.${DS_DOMAIN_NAME}', against 'resolvectl query', plus 'resolvectl domain' (the routing domain must be on the LINK, not global) and the hosts line in /etc/nsswitch.conf. A .local domain is refused by systemd-resolved because RFC 6762 reserves .local for mDNS."
          fi
          _ad_emit_status "AD unreachable: ${DS_DOMAIN_NAME} after 30 attempts"
          exit_fail "${DS_DOMAIN_NAME} is not reachable after 30 attempts. If using AWS Directory Service, verify the Route 53 outbound endpoint and forwarding rule are active."
        fi
        log_info "${DS_DOMAIN_NAME} is not reachable from this host. If using AWS Directory Service, waiting for Route 53 outbound endpoint and rule to become active. Trying again in 2 minutes. Loop count is: ${LOOP_VERIFY_AD_REACHABILITY}/30"
        _ad_emit_status "AD discover attempt ${LOOP_VERIFY_AD_REACHABILITY}/30 failed -- retrying in 180s"
        # DNS records can appear part-way through the wait, so retry the fix each round
        _ad_fix_resolver_policy "${DS_DOMAIN_NAME}" && continue
        sleep 180
      done
{% else %}
    local LOOP_VERIFY_AD_REACHABILITY=0
    while ! ${REALM} discover "$DS_DOMAIN_NAME" && [[ ${LOOP_VERIFY_AD_REACHABILITY} -lt 30 ]]
      do
        ((LOOP_VERIFY_AD_REACHABILITY++))
        log_info "${DS_DOMAIN_NAME} is not reachable from this host. If using AWS Directory Service, waiting for Route 53 outbound endpoint and rule to become active. Trying again in 2 minutes. Loop count is: ${LOOP_VERIFY_AD_REACHABILITY}/10"
        _ad_emit_status "AD discover attempt ${LOOP_VERIFY_AD_REACHABILITY}/30 failed -- retrying in 180s"
        sleep 180
      done
{% endif %}
    log_info "${DS_DOMAIN_NAME} is reachable"
    _ad_emit_status "AD reachable: ${DS_DOMAIN_NAME}"

    # Create cached location if needed. This location is restricted to admin user only
    local AD_AUTOMATION_CACHED_LOCATION="/apps/edh/{{ context.get("/configuration/ClusterId") }}/shared/custom_automation/ad_automation"
    local AD_AUTOMATION_CACHED_USERNAME_LOCATION="${AD_AUTOMATION_CACHED_LOCATION}/join_domain_user.cache"
    local AD_AUTOMATION_CACHED_PASSWORD_LOCATION="${AD_AUTOMATION_CACHED_LOCATION}/join_domain.cache"
    log_info "AD Cached Location is ${AD_AUTOMATION_CACHED_LOCATION}"

    # Retrieve account with join permission if available, otherwise query SecretManager
    # to migrate to AD OTP
    {% if context.get("/job/NodeType") == "controller" %}
      mkdir -p ${AD_AUTOMATION_CACHED_LOCATION}
      chmod 600 ${AD_AUTOMATION_CACHED_LOCATION}
      log_info "Querying SecretsManager API to retrieve AD Service Account"
      local DS_DOMAIN_ADMIN_CREDENTIALS=$(get_secret "{{ context.get("/configuration/UserDirectory/service_account_secret_arn") }}")
      if [[ -z ${DS_DOMAIN_ADMIN_CREDENTIALS} ]]; then
        exit_fail "DS_DOMAIN_ADMIN_CREDENTIALS is empty, unable to get secret info from {{ context.get("/configuration/UserDirectory/service_account_secret_arn") }}"
      fi
      local DS_DOMAIN_ADMIN_USERNAME=$(echo ${DS_DOMAIN_ADMIN_CREDENTIALS} | jq -r ". | fromjson.username")
      local DS_DOMAIN_ADMIN_PASSWORD=$(echo ${DS_DOMAIN_ADMIN_CREDENTIALS} | jq -r ". | fromjson.password")
      echo -n "${DS_DOMAIN_ADMIN_USERNAME}" > ${AD_AUTOMATION_CACHED_USERNAME_LOCATION}
      echo -n "${DS_DOMAIN_ADMIN_PASSWORD}" > ${AD_AUTOMATION_CACHED_PASSWORD_LOCATION}
      chmod 600 ${AD_AUTOMATION_CACHED_USERNAME_LOCATION}
      chmod 600 ${AD_AUTOMATION_CACHED_PASSWORD_LOCATION}
      log_info "AD Domain User cached on filesystem via ${AD_AUTOMATION_CACHED_LOCATION}"

    {% else %}
      log_info "Non SOCA controller host, fetching AD Service Account via ${AD_AUTOMATION_CACHED_LOCATION}"
      {% if context.get("/job/NodeType") == "login_node" %}
      # first login node is deployed at the same time of the controller, so to avoid race conditions, we add some sleep to ensure the controller has finalized the AD setup
      # as it's the only machine with an IAM role which allow querying Secrets Manager
      local RETRY_COUNT=0
      while [[ ! -f "${AD_AUTOMATION_CACHED_USERNAME_LOCATION}" ]] || [[ ! -f "${AD_AUTOMATION_CACHED_PASSWORD_LOCATION}" ]]; do
        if [[ ${RETRY_COUNT} -ge 30 ]]; then
            exit_fail "AD Service Account did not appear after 15 minutes. Verify SOCA Controller."
        fi
        log_info "${AD_AUTOMATION_CACHED_USERNAME_LOCATION} or ${AD_AUTOMATION_CACHED_PASSWORD_LOCATION} don't exist, waiting for SOCA controller, trying again in 30 seconds"
        sleep 60
        ((RETRY_COUNT++))
      done
      {% else %}
      # compute node - we expect the cache info to be already there.
      if [[ ! -f "${AD_AUTOMATION_CACHED_USERNAME_LOCATION}" ]] || [[ ! -f "${AD_AUTOMATION_CACHED_PASSWORD_LOCATION}" ]]; then
        exit_fail "${AD_AUTOMATION_CACHED_USERNAME_LOCATION} or ${AD_AUTOMATION_CACHED_PASSWORD_LOCATION} don't exist"
      fi
      {% endif %}

      DS_DOMAIN_ADMIN_USERNAME=$(cat "${AD_AUTOMATION_CACHED_USERNAME_LOCATION}")
      DS_DOMAIN_ADMIN_PASSWORD=$(cat "${AD_AUTOMATION_CACHED_PASSWORD_LOCATION}")
    {% endif %}

    # Handle AD case where Service Account is <User>@<Domain>, realm command prefer that we only specify the <User> as the domain is passed as arg
    DS_DOMAIN_ADMIN_USERNAME=$(echo "${DS_DOMAIN_ADMIN_USERNAME}" | awk -F '@' '{print $1}')

    # As hosts are recycled, we ensure we register them to AD with unique and random identifier (15 chars max)
    # Name include SOCA information, which can then easily be decipher by AD admins if/when they want to determine what hosts registered on their AD are SOCA related
    log_info "Generating unique & random 15 char SERVER name to be registered to AD"
    # AWS_REGION must be a function-local; the global is not exported to
    # /etc/environment (only AWS_DEFAULT_REGION is). Without this line
    # the SOCA_AD_HOSTNAME hash collapsed to "<cluster_id>--<instance_id>"
    # with empty region, which is still unique per instance but is fragile
    # for any external code that recomputes the hostname.
    local AWS_REGION=$(instance_region)
    local HOSTNAME_DATA=$(echo "${EDH_CLUSTER_ID}-${AWS_REGION}-${AWS_INSTANCE_ID}"  | openssl dgst -sha1 -binary | xxd -p | awk '{split($0,h,"."); print toupper(h[1])}')
    local HOSTNAME_PREFIX="EDH-"
    # Hash-suffix length is PINNED to 10 to stay byte-identical with the Windows
    # (ad_join_helpers.ps.j2) and Lambda (ADComputerCleaner.py) derivations, both of
    # which hardcode the last 10 hex chars. Do NOT derive this from the prefix length:
    # "EDH-" (4) + 10 = 14 <= 15 NetBIOS cap, and all three sites MUST produce the same
    # name or AD self-heal + ADComputerCleaner parity breaks.
    AVAILABLE_CHAR=10
    SHAKE_VALUE=${HOSTNAME_DATA: -${AVAILABLE_CHAR}}
    SOCA_AD_HOSTNAME="${HOSTNAME_PREFIX}${SHAKE_VALUE}"

    # Self-tag the EC2 instance with the AD computer name we are about
    # to register. The ADComputerCleaner Lambda reads this tag on
    # EC2 shutting-down to know exactly which AD object to delete --
    # avoiding any drift between bootstrap-side hash logic and the
    # Lambda's recompute fallback. Tagging is best-effort; if the call
    # fails (transient API throttle, missing permission), we still
    # proceed with the AD join because the Lambda also recomputes the
    # hash from instance metadata as a fallback.
    log_info "Self-tagging instance with edh:ADComputerName=${SOCA_AD_HOSTNAME} for AD-cleanup correlation"
    if ! aws ec2 create-tags \
            --region "${AWS_REGION}" \
            --resources "${AWS_INSTANCE_ID}" \
            --tags "Key=edh:ADComputerName,Value=${SOCA_AD_HOSTNAME}" \
            > /dev/null 2>&1
    then
        log_warning "Failed to self-tag edh:ADComputerName -- AD cleanup will fall back to hash recompute"
    fi
    
    #Note: When using a small CIDR range where IPs are frequently reused, you may encounter an issue where new EC2 instances cannot join the domain because the recycled IP is still tied to an existing AD computer object.
    #You may see errors such as:

    #Insufficient permissions to modify computer account: CN=SOCA-B073E31845,OU=Computers,OU=redacted,DC=redacted,DC=local:
    # 000021C7: AtrErr: DSID-03200E81, #1:
    # 0: 000021C7: DSID-03200E81, problem 1005 (CONSTRAINT_ATT_TYPE), data 0, Att 90303 (servicePrincipalName)

    #adcli: joining domain redacted.local failed: Insufficient permissions to modify computer account:
    #CN=SOCA-B073E31845,OU=Computers,OU=redacted,DC=redacted,DC=local:
    # 000021C7: AtrErr: DSID-03200E81, #1:
    # 0: 000021C7: DSID-03200E81, problem 1005 (CONSTRAINT_ATT_TYPE), data 0, Att 90303 (servicePrincipalName)
    
    # SOCA attempts to create a new AD object using a randomized hostname.
    # Because of this, granting UPDATE permissions to the service account does not resolve the issue—the existing AD object associated with the IP uses a different name.
    # To prevent this, configure SOCA_AD_HOSTNAME to disable hostname randomization and use a deterministic naming pattern instead. This ensures that when an IP is reused, the AD object name remains consistent and the update permissions apply correctly.
    # Uncomment the line below to enable this behavior: the AD Object will be the SC-<private-ip>, example SC-133010119. Name will never be more than 15 chars.
    
    # SOCA_AD_HOSTNAME="SC-$(hostname -I | awk '{print $1}' | tr -d '.:' | tr '[:lower:]' '[:upper:]' | tail -c 12)"

    # Check if host is not already joined to AD
    if ${REALM} list | grep -q "configured: kerberos-member"; then
      log_info "This machine is already joined to AD, checking if it's the correct domain."
      local DOMAIN_ALREADY_JOINED=$(${REALM} list | grep 'domain-name' | awk '{print $2}')
      if [[ "${DOMAIN_ALREADY_JOINED}" == "${DS_DOMAIN_NAME}" ]]; then
        # 'realm list' only proves the host *thinks* it is joined -- it is a presence test, not
        # a validity test. Per design we NEVER reuse the computer object inherited from an AMI:
        # a baked AMI ships a SHARED object + keytab whose machine-account name belongs to the
        # *bake* host, not this instance. We skip the re-join ONLY when the host is already
        # joined under ITS OWN unique name (${SOCA_AD_HOSTNAME}) AND the keytab still validates.
        # Any inherited/foreign name (shared baked object) OR a stale keytab -> abandon the
        # inherited object and rejoin CLEAN as a new unique object.
        local CURRENT_AD_NAME=$(klist -k /etc/krb5.keytab 2>/dev/null | grep -oE '[A-Za-z0-9-]+\$@' | head -1 | sed 's/\$@$//')
        log_info "Current machine-account name from keytab: '${CURRENT_AD_NAME:-<none>}'; this instance's unique name: '${SOCA_AD_HOSTNAME}'"
        if [[ -n "${CURRENT_AD_NAME}" ]] \
           && [[ "${CURRENT_AD_NAME^^}" == "${SOCA_AD_HOSTNAME^^}" ]] \
           && ${ADCLI} testjoin --domain="${DS_DOMAIN_NAME}" > /dev/null 2>&1; then
          log_info "Already joined to ${DS_DOMAIN_NAME} under this instance's own unique name ${SOCA_AD_HOSTNAME} with a valid keytab; skipping re-join."
          SKIP_AD_JOIN="true"
        else
          log_warning "Host is joined under a foreign/inherited name ('${CURRENT_AD_NAME:-<none>}' != '${SOCA_AD_HOSTNAME}') or the keytab is stale -- likely a baked-joined AMI. Abandoning the inherited object and re-joining clean as ${SOCA_AD_HOSTNAME}."
          echo "${DS_DOMAIN_ADMIN_PASSWORD}" | ${ADCLI} delete-computer -U "${DS_DOMAIN_ADMIN_USERNAME}" --stdin-password --domain="${DS_DOMAIN_NAME}" || true
          echo "${DS_DOMAIN_ADMIN_PASSWORD}" | ${REALM} leave --user "${DS_DOMAIN_ADMIN_USERNAME}" "${UPPER_DS_DOMAIN_NAME}" --verbose || true
          # SKIP_AD_JOIN stays "false" -> the join block below re-joins with a fresh unique name + new keytab
        fi
      else
        log_info "Host is joined to another domain ${DOMAIN_ALREADY_JOINED}, running realm leave"
        echo "${DS_DOMAIN_ADMIN_PASSWORD}" | ${ADCLI} delete-computer -U "${DS_DOMAIN_ADMIN_USERNAME}" --stdin-password --domain="${DOMAIN_ALREADY_JOINED}"
        echo "${DS_DOMAIN_ADMIN_PASSWORD}" | ${REALM} leave --user "${DS_DOMAIN_ADMIN_USERNAME}" "$(echo "${DOMAIN_ALREADY_JOINED}" | tr '[:lower:]' '[:upper:]')" --verbose
      fi
    fi

    # Where this node's computer object is created. Without --computer-ou adcli
    # resolves the domain's well known computer container, which a service
    # account delegated on a single OU has no rights in.
    #
    # /job/ComputerOU wins when the orchestrator set it: ephemeral and alwayson
    # HPC nodes share NodeType compute_node and are distinguished by queue,
    # which cloudformation_builder.py resolves. Everything else falls back to
    # its class in the config tree, then to computer_ou/default.
    {%- set _cou = namespace(value=context.get("/job/ComputerOU")) -%}
    {%- if not _cou.value -%}
      {%- if context.get("/job/NodeType") == "controller" -%}
        {%- set _cou.value = context.get("/configuration/UserDirectory/computer_ou/controller") -%}
      {%- elif context.get("/job/NodeType") == "login_node" -%}
        {%- set _cou.value = context.get("/configuration/UserDirectory/computer_ou/login_node") -%}
      {%- elif context.get("/job/NodeType") == "dcv_node" -%}
        {# Windows VDI never reaches this template; it joins via ad_join_helpers.ps.j2 #}
        {%- set _cou.value = context.get("/configuration/UserDirectory/computer_ou/vdi/linux")
                          or context.get("/configuration/UserDirectory/computer_ou/vdi/default") -%}
      {%- elif context.get("/job/NodeType") == "pcs_node" -%}
        {%- set _cou.value = context.get("/configuration/UserDirectory/computer_ou/hpc/pcs")
                          or context.get("/configuration/UserDirectory/computer_ou/hpc/default") -%}
      {%- elif context.get("/job/NodeType") == "compute_node" -%}
        {%- set _cou.value = context.get("/configuration/UserDirectory/computer_ou/hpc/default") -%}
      {%- endif -%}
    {%- endif -%}
    {%- if not _cou.value -%}
      {%- set _cou.value = context.get("/configuration/UserDirectory/computer_ou/default") -%}
    {%- endif %}
    # sh_quote, not a bare interpolation: these templates render with autoescape
    # on, and a DN may legally contain & " ' (EXPECT_DN_OR_EMPTY only forbids
    # , + = < > # ;). Interpolated raw, OU=R&D would reach adcli as OU=R&amp;D
    # and the join would target a non-existent OU. sh_quote returns Markup, so
    # the value is emitted verbatim and shell-quoted in one step.
    local DS_COMPUTER_OU={{ (_cou.value if _cou.value else '') | sh_quote }}

    # Built as an array so the OU is omitted entirely when unset, rather than
    # passed as an empty --computer-ou= that adcli rejects.
    local -a REALM_JOIN_ARGS=(
      join
      --user "${DS_DOMAIN_ADMIN_USERNAME}"
      "${UPPER_DS_DOMAIN_NAME}"
      --computer-name="${SOCA_AD_HOSTNAME}"
      --verbose
    )
    if [[ -n "${DS_COMPUTER_OU}" ]]; then
      REALM_JOIN_ARGS+=( --computer-ou="${DS_COMPUTER_OU}" )
      log_info "Computer object will be created in ${DS_COMPUTER_OU}"
    else
      log_info "No computer_ou configured for NodeType {{ context.get("/job/NodeType") }}; the directory default container will be used"
    fi

    # Join AD only if system is not already joined
    if [[ "${SKIP_AD_JOIN}" == "false" ]]; then
      local JOIN_AD_ATTEMPT=0
      log_info "Trying to join host to AD as ${SOCA_AD_HOSTNAME}"
      _ad_emit_status "AD: joining domain as ${SOCA_AD_HOSTNAME}"
      while ! echo "${DS_DOMAIN_ADMIN_PASSWORD}" | ${REALM} "${REALM_JOIN_ARGS[@]}"
      do
        ((JOIN_AD_ATTEMPT++))
        local SLEEP_TIME=$(( RANDOM % 60 ))
        log_info "Realm join didn't complete successfully. Retrying in ${SLEEP_TIME} seconds... Loop count is: ${JOIN_AD_ATTEMPT}/10"
        _ad_emit_status "AD join attempt ${JOIN_AD_ATTEMPT}/10 failed -- retrying in ${SLEEP_TIME}s"
        sleep ${SLEEP_TIME}
        if [[ ${JOIN_AD_ATTEMPT} -eq 10 ]]; then
          _ad_emit_status "AD join failed after 10 attempts"
          exit_fail "Unable to join domain after 10 attempts"
        fi
      done
      _ad_emit_status "AD join succeeded"
    fi

    log_info "Joined realm ${DS_DOMAIN_NAME} successfully"
    log_info "Adding AD Admin Group Name to sudoers"
    echo -e "
  ## Add the \"${SOCA_DIRECTORY_ADMIN_GROUP_NAME}\" group from the ${DS_DOMAIN_NAME} domain.
  %${ESCAPED_SOCA_DIRECTORY_ADMIN_GROUP_NAME} ALL=(ALL:ALL) ALL
  " >> /etc/sudoers

    log_info "Configuring SSSD to work with AD"
    cp /etc/sssd/sssd.conf /etc/sssd/sssd.conf.original.$(date +%s)
    echo -e "[sssd]
domains = ${DS_DOMAIN_NAME}
config_file_version = 2
services = nss, pam, sudo

[domain/${DS_DOMAIN_NAME}]
access_provider = ad
ad_domain = ${DS_DOMAIN_NAME}
auth_provider = ad
cache_credentials = True
default_shell = /bin/bash
entry_cache_timeout = 500
fallback_homedir = /data/home/%u
id_provider = ad
krb5_realm = ${UPPER_DS_DOMAIN_NAME}
krb5_store_password_if_offline = True
ldap_id_mapping = False
ldap_sasl_authid = ${SOCA_AD_HOSTNAME}$
ldap_schema = ad
ldap_sudo_search_base = ${SOCA_DIRECTORY_ADMINS_SEARCH_BASE}
ldap_tls_reqcert = never
realmd_tags = manages-system joined-with-adcli
use_fully_qualified_names = False
{% if context.get('/job/NodeType') == "dcv_node" %}ad_gpo_map_interactive = +dcv{% endif %}

[nss]
homedir_substring = /data/home

[pam]

[autofs]

[ssh]" > /etc/sssd/sssd.conf

      chmod 600 /etc/sssd/sssd.conf
      systemctl enable sssd
      systemctl restart sssd
      echo "sudoers: files sss" >> /etc/nsswitch.conf
  }
  join_ad

  {% if context.get("/job/NodeType") == "controller" and context.get("/configuration/UserDirectory/provider") == "aws_ds_managed_activedirectory" %}
      # If we are a controller using AWS DS Managed AD - apply AD password policy updates
      log_info "AWS DS Managed AD - Apply PW policy"
      {% include "templates/linux/user_directory/active_directory/apply_ad_password_policy.sh.j2" %}
  {% endif %}

{% endif %}
# End: Join Active Directory