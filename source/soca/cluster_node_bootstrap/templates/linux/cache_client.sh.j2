# Begin: Cache Client (CLI installer + Wrapper functions)


{% if context.get("/configuration/Cache/enabled") %}

  # Install Cache CLI if needed (only on controller).
  # You can add compute_node as well, however please note CLI install will take a couple of minutes.
  # Create SOCA Optimized AMI to avoid this time penalty for ephemeral nodes  https://awslabs.github.io/engineering-development-hub-documentation/tutorials/reduce-compute-node-launch-time-with-custom-ami/
  {% if context.get("/job/NodeType") in ("controller") %}
    function install_cache_cli() {
      log_info "Installing Cache CLI client"
      mkdir -p "${EDH_BOOTSTRAP_ASSETS_FOLDER}/cache"
      pushd "${EDH_BOOTSTRAP_ASSETS_FOLDER}/cache"
      {% if context.get("/configuration/Cache/engine") == "redis" %}
        # Note: do not yum install redis as the default package won't include TLS support (required for ElastiCache)
        CACHE_CMD="/usr/local/bin/redis-cli"
        if [[ ! -f ${CACHE_CMD} ]]; then
          log_info "Building redis-cli client with --tls support"
          file_download --download-url="{{ context.get("/system/cache_client/redis/url") }}"  --save-as="redis-stable.tar.gz"
          tar xvzf redis-stable.tar.gz --strip-components=1 -C .
          make distclean
          make redis-cli BUILD_TLS=yes
          sudo install -m 755 src/redis-cli /usr/local/bin/
        else
          log_info "${CACHE_CMD} already exist, skipping REDIS install"
        fi

      {% elif context.get("/configuration/Cache/engine") == "valkey" %}
        CACHE_CMD="/usr/local/bin/valkey-cli"
        if [[ ! -f ${CACHE_CMD} ]]; then
          log_info "Building valkey client"
          file_download --download-url="{{ context.get("/system/cache_client/valkey/url") }}" --save-as="valkey.tar.gz" --sha256-checksum="{{ context.get("/system/cache_client/valkey/sha256") }}"
          tar xvzf valkey.tar.gz --strip-components=1 -C .
          make distclean
          make valkey-cli BUILD_TLS=yes
          sudo install -m 755 src/valkey-cli /usr/local/bin/
        else
          log_info "${CACHE_CMD} already exist, skipping VALKEY install"
        fi
      {% endif %}
      popd
    }
    install_cache_cli

    # WRAPPER FUNCTIONS BELOW
    # IAM auth: mint a short-lived SigV4 ElastiCache "connect" token in place of a
    # static password. The token is disk-cached and refreshed when older than
    # ~600s (AWS caps validity at 900s; it is only consumed at connect). Signing
    # is a local operation off the instance-role credentials -- no secret is read.
    function get_cache_iam_token() {
      local CACHE_NAME="{{ context.get("/configuration/ClusterId") }}-cache"
      local CACHE_USER_ID="{{ context.get("/configuration/ClusterId") }}-controller"
      local CACHE_REGION="{{ context.get("/configuration/Region") }}"
      local SOCA_PYTHON_BIN="/opt/edh/{{ context.get("/configuration/ClusterId") }}/python/latest/bin/python3"
      local TOKEN_PATH="${EDH_BOOTSTRAP_ASSETS_FOLDER}/.cache_iam_token_{{ context.get('/configuration/ClusterId') }}.cache"

      # Reuse a cached token unless it is missing or older than 600s.
      if [[ -f "${TOKEN_PATH}" ]]; then
        local NOW TOKEN_MTIME AGE
        NOW=$(date +%s)
        TOKEN_MTIME=$(stat -c %Y "${TOKEN_PATH}" 2>/dev/null || echo 0)
        AGE=$((NOW - TOKEN_MTIME))
        if [[ ${AGE} -lt 600 ]]; then
          cat "${TOKEN_PATH}"
          return 0
        fi
      fi

      local CACHE_IAM_TOKEN
      CACHE_IAM_TOKEN=$("${SOCA_PYTHON_BIN}" - "${CACHE_NAME}" "${CACHE_USER_ID}" "${CACHE_REGION}" <<'PYEOF'
import sys
from botocore.session import get_session
from botocore.auth import SigV4QueryAuth
from botocore.awsrequest import AWSRequest
cache_name, user_id, region = sys.argv[1], sys.argv[2], sys.argv[3]
creds = get_session().get_credentials()
req = AWSRequest(method="GET", url="https://%s/" % cache_name,
                 params={"Action": "connect", "User": user_id})
SigV4QueryAuth(creds, "elasticache", region, expires=900).add_auth(req)
sys.stdout.write(req.prepare().url[len("https://"):])
PYEOF
)
      if [[ -z "${CACHE_IAM_TOKEN}" ]]; then
        log_error "Failed to mint ElastiCache IAM token for ${CACHE_USER_ID}"
        return 1
      fi
      ( umask 077; echo -n "${CACHE_IAM_TOKEN}" > "${TOKEN_PATH}" )
      echo -n "${CACHE_IAM_TOKEN}"
    }

    function cache_get_key () {
      local CACHE_KEY="${1}"
      local CACHE_RESULT_FORMAT="${2}"
      local CACHE_VALUE
      local CACHE_GET_COMMAND
      local CACHE_CMD
      local CACHE_USERNAME
      local CACHE_PASSWORD
      local CACHE_ENDPOINT
      local CACHE_PORT
      CACHE_USERNAME="{{ context.get("/configuration/ClusterId") }}-controller"
      CACHE_PASSWORD=$(get_cache_iam_token)
      if [[ $? -ne 0 || -z "${CACHE_PASSWORD}" ]]; then
        log_error "unable to mint ElastiCache IAM token; aborting cache_get_key"
        return 1
      fi
      CACHE_ENDPOINT="{{ context.get("/configuration/Cache/endpoint") }}"
      CACHE_PORT="{{ context.get("/configuration/Cache/port") }}"

      # Cache client is installed via cache_client_install.sh.h2
      {% if context.get("/configuration/Cache/engine") == "valkey" %}
        CACHE_CMD="/usr/local/bin/valkey-cli"
      {% elif context.get("/configuration/Cache/engine") == "redis" %}
        CACHE_CMD="/usr/local/bin/redis-cli"
      {% endif %}

      if [[ ${CACHE_RESULT_FORMAT} == "json" ]]; then
        CACHE_GET_COMMAND="JSON.GET"
      else
        CACHE_GET_COMMAND="GET"
      fi

      # Redirect stderr to /dev/null to hide warning due to --pass (see below) otherwise CACHE_VALUE will also contains this message
      # Warning: Using a password with '-a' or '-u' option on the command line interface may not be safe.
      # Another option is to remove --pass and leverage env variable, but need to review if/when Valkey will stop relying on REDIS_PASSWORD
      CACHE_VALUE=$(${CACHE_CMD} --tls -h ${CACHE_ENDPOINT} -p ${CACHE_PORT} --user ${CACHE_USERNAME} --pass ${CACHE_PASSWORD} ${CACHE_GET_COMMAND} "${CACHE_KEY}" 2>/dev/null)
      if [[ -z ${CACHE_VALUE+x} ]] || [[ ${CACHE_VALUE} == "(nil)" ]] || [[ -z ${CACHE_VALUE} ]]; then
        echo -n "CACHE_MISS"
      else
        echo -n "${CACHE_VALUE}"
      fi
    }
  {% else %}
    # Cache not deployed on this machine
    function cache_get_key () {
      echo -n "CACHE_MISS"
    }
  {% endif %}

{% else %}
  # Cache not enabled, always return CACHE_MISS.
  function cache_get_key () {
    echo -n "CACHE_MISS"
  }
{% endif %}
# End: Cache Client
