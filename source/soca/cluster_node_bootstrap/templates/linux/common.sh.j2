{% include "templates/linux/common/log.sh.j2" %}

{# DCV event-relay publisher is NOT included here -- common.sh.j2 is #}
{# sourced by the controller and HPC compute_node bootstraps which do #}
{# not publish DCV events. Including it here pushes controller        #}
{# user_data over the 16KB EC2 cap. The publisher is included only    #}
{# from the VDI bootstrap path: compute_node/02_setup.sh.j2 and       #}
{# compute_node/03_setup_post_reboot.sh.j2, gated on NodeType=dcv_node.#}
{# log_checkpoint and log_status in log.sh.j2 detect publisher absence #}
{# via `declare -F` and silently no-op the publish (log line still     #}
{# fires locally), so they remain safe to call from any bootstrap.     #}

