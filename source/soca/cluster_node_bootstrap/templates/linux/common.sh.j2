{% set PATH = '/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin:/opt/edh/' ~ context.get("/configuration/ClusterId") ~ ':/opt/edh/' ~ context.get("/configuration/ClusterId") ~ '/packages/sqlite/bin' %}
export PATH={{ PATH }}:${PATH}

# Source environment
set -a  # auto-export vars (bare /etc/environment KEY=value lines are not exported on source)
source /etc/environment
set +a

# Source SOCA_PYTHON if exist
SOCA_PYTHON_ENV_PATH="/opt/edh/{{ context.get("/configuration/ClusterId") }}/python/latest/edh_python.env"

if [[ -f "${SOCA_PYTHON_ENV_PATH}" ]]; then
    source "${SOCA_PYTHON_ENV_PATH}"
fi