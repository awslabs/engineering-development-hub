# SCHEDULER_VARS are forwarded from templates/linux/schedulers/install_schedulers.sh.j2:

# Begin: OpenPBS Configure Client
function openpbs_configure_client_{{  SCHEDULER_VARS.get("IDENTIFIER") }} () {
    log_info "[BEGIN] openpbs_configure_client... "
    local SCHEDULER_HOSTNAME="{{ SCHEDULER_VARS.get("ENDPOINT") }}"
    local OPENPBS_PBS_HOME="{{ SCHEDULER_VARS.get("PBS_CONFIGURATION").get("pbs_home") }}"
    local OPENPBS_INSTALL_DIR="{{ SCHEDULER_VARS.get("PBS_CONFIGURATION").get("pbs_exec") }}"
    local CLIENT_SERVER_IP=$(echo -n $(imds_get /latest/meta-data/local-ipv4)) # IMDS is safest vs hostname -I, especially if you have multiple network interfaces
    log_info "Removing /etc/pbs.conf if exists, use ${PBSPRO_INSTALL_DIR}/pbs.conf instead. Copy created to /etc/pbs.conf.original.$(date +%s)"
    if [[ -f /etc/pbs.conf ]]; then
        mv /etc/pbs.conf /etc/pbs.conf.original.$(date +%s)
    fi
    {#
      Only a compute_node runs a mom, because compute_node is the only type
      nodes_manager registers with qmgr -- a mom on any other node announces
      itself to a server that has never heard of it, once a minute forever.

      This template is reached by EVERY non-controller Linux node:
      install_schedulers.sh.j2 branches only on "controller". The same gate is
      in lsf/configure_client.sh.j2.

      The mom_priv/config block below is deliberately NOT gated: it is read by
      the mom that stages a job's files, which is the compute node's mom.
    #}
    {% if context.get("/job/NodeType") == "compute_node" %}
    local START_MOM=1
    log_info "NodeType is compute_node, pbs_mom will be started"
    {% else %}
    local START_MOM=0
    log_info "NodeType is {{ context.get("/job/NodeType") }}, pbs_mom will NOT be started (this node is not registered with the scheduler)"
    {% endif %}
    echo -e "PBS_SERVER=${SCHEDULER_HOSTNAME}
PBS_START_SERVER=0
PBS_START_SCHED=0
PBS_START_COMM=0
PBS_START_MOM=${START_MOM}
PBS_EXEC=${OPENPBS_INSTALL_DIR}
PBS_LEAF_NAME=${CLIENT_SERVER_IP}
PBS_HOME=${OPENPBS_PBS_HOME}
PBS_CORE_LIMIT=unlimited
PBS_SCP=/usr/bin/scp
" > ${OPENPBS_INSTALL_DIR}/pbs.conf

    # For now create a symbolic link for ${OPENPBS_INSTALL_DIR}/pbs.conf
    ln -sf  ${OPENPBS_INSTALL_DIR}/pbs.conf /etc/pbs.conf

  cp ${OPENPBS_PBS_HOME}/mom_priv/config ${OPENPBS_PBS_HOME}/mom_priv/config.original."$(date +%s)"
  echo -e "
\$clienthost ${SCHEDULER_HOSTNAME}
\$usecp *:/dev/null /dev/null
\$usecp *:/data /data
\$usecp *:/apps /apps
# Shared scratch directories should also be added here
# \$usecp *:/fsx /fsx
"  > ${OPENPBS_PBS_HOME}/mom_priv/config
  log_info "[COMPLETED] openpbs_post_install_mom_config_client... "
}

openpbs_configure_client_{{  SCHEDULER_VARS.get("IDENTIFIER") }}
# End: OpenPBS Configure Client