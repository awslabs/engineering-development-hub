{% if "templates/linux/shared_storage/nfs_wrapper.sh.j2" not in ns.template_already_included %}
  {% set _ = ns.template_already_included.append("templates/linux/shared_storage/nfs_wrapper.sh.j2") %}

  function fstab_wrapper () {
    # $1 = <file system> <mount point> <type> <options> <dump> <pass>
    # filesystem: The device/partition (by /dev location or UUID) that contain a file system.
    # mount point: The directory on your root file system (aka mount point) from which it will be possible to access the content of the device/partition. Mount points should not have spaces in the names.
    # type: Type of file system (ext4, nfs4, lustre ..)
    # options: Mount options of access to the device/partition
    # dump: Enable or disable backing up of the device/partition. Default to 0 (Disable) it if not specified
    # pass: Controls the order in which fsck checks the device/partition for errors at boot time. The root device should be 1. Other partitions should be 2, or 0 to disable checking. Default to 0 if not set
    # eg: 10.1.1.6:/   /mypath          nfs4    defaults   0       0

    # Note: Return 0 for successful mount or 1 for error

    local FSTAB_ENTRY=(${1})
    local MOUNT_FILESYSTEM=${FSTAB_ENTRY[0]}
    local MOUNT_POINT=${FSTAB_ENTRY[1]}
    local MOUNT_TYPE=${FSTAB_ENTRY[2]}
    local MOUNT_OPTIONS=${FSTAB_ENTRY[3]}
    local MOUNT_DUMP=${FSTAB_ENTRY[4]-"0"}
    local MOUNT_PASS=${FSTAB_ENTRY[5]-"0"}

    local MOUNTED_SOURCE
    local MOUNT_ATTEMPT
    local MOUNT_MAX_ATTEMPTS=5
    local FSTAB_ENTRY_EXISTS="false"

    log_info "Received new fstab entry request: ${FSTAB_ENTRY[*]}"

    if [[ -z "${MOUNT_FILESYSTEM}" ]] || [[ -z "${MOUNT_POINT}" ]] || [[ -z "${MOUNT_TYPE}" ]] || [[ -z "${MOUNT_OPTIONS}" ]]; then
      log_error "Invalid entry. Expected <filesystem> <mount_point> <mount_type> <options> [[<dump> <pass>]], received ${FSTAB_ENTRY[*]}"
      return 1
    fi

    # An /etc/fstab line is NOT proof of a mount. The line is appended before
    # the first mount attempt and is deliberately left in place when every
    # attempt fails, so that the systemd _netdev unit can mount it once the
    # filesystem becomes reachable. Returning 0 here reported success for a
    # filesystem that had never mounted, and hid it on every later run: the
    # mount-table check below was unreachable. Record the entry so it is not
    # duplicated, then fall through and verify the mount for real.
    if grep -qF "${MOUNT_FILESYSTEM} ${MOUNT_POINT}" /etc/fstab; then
      log_info "This entry already exists on /etc/fstab, verifying it is mounted"
      FSTAB_ENTRY_EXISTS="true"
    fi

    # Anchor the probe on the exact mount point. `mount | grep "${MOUNT_POINT}"`
    # matched the path as a SUBSTRING of any mount table line, so a request for
    # /apps while /apps/scratch was mounted compared the device of the wrong
    # filesystem and refused a legitimate mount with "mounted to a different
    # disk". findmnt --mountpoint matches the mount point and nothing else.
    # --target must not be used here: for a path that is not itself a mount
    # point it reports the filesystem CONTAINING the path, which reintroduces
    # the same false mismatch. --first-only keeps the comparison to the
    # top-most filesystem when the mount point carries an over-mount.
    if MOUNTED_SOURCE=$(findmnt -rn -f -o SOURCE --mountpoint "${MOUNT_POINT}" 2>/dev/null); then
      if [[ "${MOUNTED_SOURCE}" == *"${MOUNT_FILESYSTEM}"* ]]; then
        log_info "${MOUNT_POINT} is already mounted"
        return 0
      else
        log_error "${MOUNT_POINT} is mounted to a different disk: ${MOUNTED_SOURCE}"
        return 1
      fi
    fi

    {% if context.get("/job/BaseOS") in ("ubuntu2204", "ubuntu2404") %}
      # Debian Based distro
      {% set BIND_PKG = "bind9-utils" %}
      {% set NFS_UTILS_PKG = "nfs-common" %}

    {% else %}
      # RHEL Based distro
      {% set BIND_PKG = "bind-utils" %}
      {% set NFS_UTILS_PKG = "nfs-utils" %}

    {% endif %}

    if ! verify_package_installed {{ BIND_PKG }}; then
      log_info "Installing {{ BIND_PKG }}"
      packages_install {{ BIND_PKG }}
    fi

    if ! verify_package_installed {{ NFS_UTILS_PKG }}; then
      log_info "Installing {{ NFS_UTILS_PKG }}"
      packages_install {{ NFS_UTILS_PKG }}
    fi

    log_info "Creating ${MOUNT_POINT} if needed"
    mkdir -p ${MOUNT_POINT}

    # Adding to /etc/fstab
    if [[ "${FSTAB_ENTRY_EXISTS}" == "true" ]]; then
      log_info "${MOUNT_FILESYSTEM} ${MOUNT_POINT} is already in /etc/fstab, not adding a duplicate"
    else
      log_info "Adding ${MOUNT_FILESYSTEM} ${MOUNT_POINT} ${MOUNT_TYPE} ${MOUNT_OPTIONS} ${MOUNT_DUMP} ${MOUNT_PASS} to /etc/fstab"
      echo "${MOUNT_FILESYSTEM} ${MOUNT_POINT} ${MOUNT_TYPE} ${MOUNT_OPTIONS} ${MOUNT_DUMP} ${MOUNT_PASS}" >> /etc/fstab
    fi

    # Trying to mount
    for ((MOUNT_ATTEMPT=1; MOUNT_ATTEMPT<=MOUNT_MAX_ATTEMPTS; MOUNT_ATTEMPT++)); do
      log_info "Mounting attempt ${MOUNT_ATTEMPT}/${MOUNT_MAX_ATTEMPTS} ..."

      if mount ${MOUNT_POINT}; then
        log_info "mount ${MOUNT_POINT} command completed successfully"
        return 0
      fi

      if [[ "${MOUNT_ATTEMPT}" -eq "${MOUNT_MAX_ATTEMPTS}" ]]; then
        log_error "Failed to mount ${MOUNT_FILESYSTEM} on ${MOUNT_POINT} after ${MOUNT_MAX_ATTEMPTS} attempts."
        return 1
      fi

      local SLEEP_TIME=$(( RANDOM % 60 ))
      log_info "mount ${MOUNT_POINT} failed, retrying in ${SLEEP_TIME} seconds"
      sleep ${SLEEP_TIME}
    done

    log_error "Failed to mount ${MOUNT_FILESYSTEM} on ${MOUNT_POINT} after ${MOUNT_MAX_ATTEMPTS} attempts."
    return 1
  }
{% endif %}
