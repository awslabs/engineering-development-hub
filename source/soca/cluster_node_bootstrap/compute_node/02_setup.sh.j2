#!/bin/bash -xe

# Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
# SPDX-License-Identifier: Apache-2.0

# Log Path: {{ context.get("/job/BoostrapPath") }}
############
{% include "templates/linux/common.sh.j2" %}

{# log_checkpoint / log_status helpers. Defined here (not in log.sh.j2) #}
{# because log.sh.j2 is in the controller LT UserData path which is    #}
{# capped at 16KB. This file is only sourced from compute_node S3      #}
{# bootstrap scripts where there is no size cap.                        #}
{% include "templates/linux/common/log_checkpoint.sh.j2" %}

{# DCV event-relay publisher: ONLY include for VDI nodes. Adds ~6.4KB #}
{# to user_data; controller and HPC compute paths do not need it.    #}
{% if context.get("/job/NodeType") == "dcv_node" %}
{% include "templates/linux/dcv/dcv_event_publish.sh.j2" %}
{% endif %}

# Validate umask
{% include "templates/linux/umask.sh.j2" %}

log_info "Setup Start Date: $(date)"
log_info "Running Kernel $(uname -r)"

# DCV event-relay: emit boot-started checkpoint as the first signal that
# this VDI's userdata has begun. log_checkpoint is a no-op on HPC compute
# nodes (no EDH_DCV_SESSION_EVENTS_QUEUE_URL / EDH_DCV_SESSION_ID) and on
# clusters that don't have event-relay enabled.
log_checkpoint "boot-started" "Bootstrap entered 02_setup"

# Stop/Disable scheduler if running
{% include "templates/linux/scheduler/stop_scheduler_services.sh.j2" %}

# Install Required System library/packages
{% include "templates/linux/system_packages/install_required_packages.sh.j2" %}

# Create /opt/edh/{{ context.get('/configuration/ClusterId') }}/ if needed
mkdir -p /opt/edh/{{ context.get('/configuration/ClusterId') }}/

{% if context.get("/job/BaseOS") in ("ubuntu2204", "ubuntu2404") %}
  log_info "Disabling auto-update on Ubuntu"
  sed -ie 's/"1"/"0"/g' /etc/apt/apt.conf.d/20auto-upgrades
{% endif %}

# Add cache client functions (Cache CLI is automatically installed if needed)
{% include "templates/linux/cache_client.sh.j2" %}

# Adding additional SOCA Environment Variables
set_environment_variable "AWS_DEFAULT_REGION" "{{ context.get("/configuration/Region") }}"
set_environment_variable "EDH_BOOTSTRAP_ASSETS_FOLDER" "/root/edh_bootstrap_$(instance_id)"
set_environment_variable "EDH_BOOTSTRAP_LOGS_FOLDER" "${EDH_JOB_BOOTSTRAP_PATH}/$(hostname -s)"
set_environment_variable "EDH_NODE_TYPE" "{{ context.get("/job/NodeType") }}"
set_environment_variable "EDH_VERSION" "{{ context.get("/configuration/Version") }}"
set_environment_variable "EDH_INSTALL_BUCKET" "{{ context.get("/configuration/S3Bucket") }}"
set_environment_variable "EDH_CONTROLLER_IP" "{{ context.get("/configuration/ControllerPrivateIP") }}"
set_environment_variable "EDH_HOME" "/opt/edh/{{ context.get("/configuration/ClusterId") }}"
set_environment_variable "EDH_CLUSTER_ID" "{{ context.get("/configuration/ClusterId") }}"
set_environment_variable "SOCA_CLUSTER_ID" "{{ context.get("/configuration/ClusterId") }}" # Legacy

{% if context.get("/job/NodeType") == "compute_node" %}
  # Added via cluster_manager/orchestrator/cloudformation_builder.py
  set_environment_variable "EDH_JOB_QUEUE" "${EDH_JOB_QUEUE}"
  set_environment_variable "EDH_JOB_OWNER" "${EDH_JOB_OWNER}"
  set_environment_variable "EDH_JOB_NAME" "${EDH_JOB_NAME}"
  set_environment_variable "EDH_JOB_PROJECT" "${EDH_JOB_PROJECT}"
  set_environment_variable "EDH_JOB_ID" "${EDH_JOB_ID}"
{% elif context.get("/job/NodeType") == "dcv_node" %}
  # Added via cluster_manager/web_interface/api/v1/dcv/create_linux_desktop.py
  # Pool members boot unassigned (session set at claim time), so these are empty
  # at provision; set_environment_variable fatals on an empty value -- guard it.
  if [[ -n "${EDH_DCV_SESSION_OWNER}" ]]; then
    set_environment_variable "EDH_DCV_SESSION_OWNER" "${EDH_DCV_SESSION_OWNER}"
    # Set the EDH_DCV_SESSION_ID (same name on Windows). This is used by the scheduled task to retrieve the DCV Session ID
    set_environment_variable "EDH_DCV_SESSION_ID" "${EDH_DCV_SESSION_ID}"
    set_environment_variable "EDH_DCV_SESSION_NAME" "${EDH_DCV_SESSION_NAME}"
  fi
  if [[ -n "${EDH_DCV_SESSION_EVENTS_QUEUE_URL:-}" ]]; then
    set_environment_variable "EDH_DCV_SESSION_EVENTS_QUEUE_URL" "${EDH_DCV_SESSION_EVENTS_QUEUE_URL}"
  fi
  # NOTE: pool-member session-env vars are NOT persisted here -- 03_setup_post_reboot
  # re-sources 00_session_env.sh post-reboot instead.
{% elif context.get("/job/NodeType") == "login_node" %}
  set_environment_variable "EDH_BOOTSTRAP_LOGS_FOLDER" "/apps/edh/{{ context.get("/configuration/ClusterId") }}/shared/logs/bootstrap/login_node/$(hostname -s)"
{% endif %}

# Install jq
{% include "templates/linux/jq.sh.j2" %}


# Configure Scratch Partition is scratch_size is specified or instance has local disks
{% include "templates/linux/configure_scratch_partition.sh.j2" %}

# Install CloudWatch Log Agent
{% include "templates/linux/aws_cloudwatch_agent.sh.j2" %}

# Configure /etc/hosts
{% include "templates/linux/configure_hosts.sh.j2" %}

# Install/Load SOCA Python
{% include "templates/linux/soca_python.sh.j2" %}

# Install and configure HPC schedulers.
{% include "templates/linux/scheduler/install_schedulers.sh.j2" %}
   
# Disable SELINUX
{% include "templates/linux/disable_selinux.sh.j2" %}

# Disable FirewallD
{% include "templates/linux/disable_firewalld.sh.j2" %}

# Configure OpenLDAP or Microsoft AD
{% if context.get("/configuration/UserDirectory/provider") in ["existing_openldap", "openldap"] %}
  # OpenLDAP configuration
  {% include "templates/linux/user_directory/openldap/openldap_client.sh.j2" %}
{% elif context.get("/configuration/UserDirectory/provider") in ["existing_active_directory","aws_ds_managed_activedirectory"] %}
  # Active Directory configuration. The included script has its own
  # built-in retry loops (realm discover up to 30x with 180s backoff,
  # realm join up to 10x with random backoff) so we DO NOT wrap with
  # edh_retry_phase here -- that would multiply the retry count and
  # blow up the worst-case bootstrap time. Status events are emitted
  # from inside the inner loops via guarded edh_dcv_publish_event calls.
  {% include "templates/linux/user_directory/active_directory/join_activedirectory.sh.j2" %}
{% else %}
  exit_fail "UserDirectory/provider must be one of existing_active_directory, existing_openldap, openldap, or aws_ds_managed_activedirectory. Detected {{ context.get("/configuration/UserDirectory/provider") }}"
{% endif %}

# Disable StrictHostKeyChecking
{% include "templates/linux/disable_ssh_strict_host_key_check.sh.j2" %}

# Configure Chrony
{% include "templates/linux/chronyd.sh.j2" %}

# Disable ulimits
{% include "templates/linux/disable_ulimits.sh.j2" %}

# Tag EBS disks manually as CFN ASG does not support it
{% include "templates/linux/tags/ebs.sh.j2" %}

# Tag Network Interface for the Compute Node
{% include "templates/linux/tags/eni.sh.j2" %}

log_info "Setup End Date: $(date)"

# Prepare crontab for post-reboot or execute the post-reboot script automatically
REBOOT_REQUIRED=$(get_reboot_required)
if [[ "${REBOOT_REQUIRED}" == "yes" ]]; then
    (crontab -l 2>/dev/null; echo "@reboot /bin/bash ${EDH_BOOTSTRAP_ASSETS_FOLDER}/03_setup_post_reboot.sh >> ${EDH_BOOTSTRAP_LOGS_FOLDER}/03_setup_post_reboot.log 2>&1") | crontab -
    log_info "Final bootstrap sequence will be executed post reboot, verifying crontab"
    crontab -l
    log_info "Rebooting the machine"
    reboot
else
    log_info "No reboot needed, continuing bootstrap sequence"
    /bin/bash "${EDH_BOOTSTRAP_ASSETS_FOLDER}/03_setup_post_reboot.sh" >> ${EDH_BOOTSTRAP_LOGS_FOLDER}/03_setup_post_reboot.log 2>&1
fi