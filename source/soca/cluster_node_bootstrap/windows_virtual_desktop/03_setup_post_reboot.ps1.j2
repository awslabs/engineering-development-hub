}

{% if  context.get('/configuration/UserDirectory/provider') in ("aws_ds_managed_activedirectory", "existing_active_directory") %}
# --- AD self-heal rescue: finish a pending clean rejoin (Shape 2) ------------------------
# join_activedirectory (in 02_setup) detected a DIRTY AMI (host booted joined under a
# foreign/shared object), unjoined to WORKGROUP, dropped this marker, and rebooted. The
# framework's post-reboot pass runs THIS script (not 02/join), so the clean rejoin as the
# unique object is completed here, then we reboot once more to apply it. On that next boot the
# marker is gone and 03 proceeds to its normal finish (now domain-joined).
$rescueMarker = Join-Path $EDHBootstrapAssetsFolder 'ad_rescue_pending.flag'
if (Test-Path $rescueMarker) {
    $UniqueName = (Get-Content -Path $rescueMarker -Raw).Trim()
    Log-Info -Message "AD rescue: pending clean rejoin as $UniqueName (current name $env:COMPUTERNAME, PartOfDomain=$((Get-WmiObject Win32_ComputerSystem).PartOfDomain))"
    $secret = Get-Secret -SecretId "{{ context.get('/configuration/UserDirectory/service_account_secret_arn') }}"
    if ($secret) {
        $sau = $secret.username.Split('@')[0]
        $sp  = ConvertTo-SecureString "$($secret.password)" -AsPlainText -Force
        $cred = New-Object System.Management.Automation.PSCredential -ArgumentList "{{ context.get('/configuration/UserDirectory/short_name') }}\$sau",$sp
        if (Invoke-SocaCleanDomainJoin -DomainName "{{ context.get('/configuration/UserDirectory/domain_name') }}" -Credential $cred -UniqueName $UniqueName) {
            Remove-Item $rescueMarker -Force -ErrorAction SilentlyContinue
            # Re-arm this post-reboot task so 03 runs again after the rejoin reboot to finish normally.
            $rescueScript = "$EDHBootstrapAssetsFolder\03_setup_post_reboot.ps1"
            $rescueAction = New-ScheduledTaskAction -Execute "powershell.exe" -Argument "-ExecutionPolicy Bypass -File $rescueScript  *> $EDHBootstrapAssetsFolder\03_setup_post_reboot.ps1.log"
            $rescueTrigger = New-ScheduledTaskTrigger -AtStartup
            $rescueSettings = New-ScheduledTaskSettingsSet -StartWhenAvailable
            Register-ScheduledTask -Action $rescueAction -Trigger $rescueTrigger -Settings $rescueSettings -TaskName $taskName -Description "EDH Final Setup post-reboot" -Force
            Log-Info -Message "AD rescue: clean rejoin as $UniqueName staged; rebooting to apply, 03 will resume after."
            Restart-Computer -Force
            Start-Sleep -Seconds 120   # hold while the reboot is pending; do not continue 03 this pass
            exit 0
        } else {
            # Rejoin failed after retries. Remove the marker to avoid an infinite reboot loop and
            # continue (degraded: WORKGROUP). The loud error is visible via SSM for re-bake.
            Remove-Item $rescueMarker -Force -ErrorAction SilentlyContinue
            Write-Error "AD rescue: clean rejoin as $UniqueName FAILED after retries; continuing in WORKGROUP (re-bake the AMI un-joined)."
        }
    } else {
        Remove-Item $rescueMarker -Force -ErrorAction SilentlyContinue
        Write-Error "AD rescue: could not retrieve service account secret; continuing in WORKGROUP."
    }
}
{% endif %}

{% if  context.get('/configuration/UserDirectory/provider') in ("aws_ds_managed_activedirectory", "existing_active_directory") %}
# --- AD identity convergence (normal-path half-join repair) ---------------------------------
# 02_setup stages the join+rename via Add-Computer JoinWithNewName, which only applies on
# reboot. If that rename did not take effect (machine still carries its EC2 sysprep name) or
# the secure channel is broken, the box is half-joined: the unique SOCA-<hash> AD object exists
# but THIS machine identifies as its EC2 name (no matching account) -> domain logins fail with
# "the security database on the server does not have a computer account for this workstation
# trust relationship". Converge by reusing the proven Shape-2 rescue: unjoin to WORKGROUP +
# drop the rescue marker, then reboot -- the rescue block above completes the clean rejoin as
# the expected unique name on the next pass. Idempotent (no-op once correctly named + trusted)
# and capped at 3 attempts so a persistent failure fails loud instead of reboot-looping.
$rescueMarker = Join-Path $EDHBootstrapAssetsFolder 'ad_rescue_pending.flag'
$expectedAdName = Get-SocaAdHostname -ClusterId "{{ context.get('/configuration/ClusterId') }}"
$cs = Get-WmiObject Win32_ComputerSystem
$secureChannelOk = $false
try { $secureChannelOk = Test-ComputerSecureChannel -ErrorAction Stop } catch { $secureChannelOk = $false }
if (-not ($cs.PartOfDomain -and ($env:COMPUTERNAME -eq $expectedAdName) -and $secureChannelOk)) {
    $convAttemptFile = Join-Path $EDHBootstrapAssetsFolder 'ad_converge_attempts.txt'
    $convAttempts = 0
    if (Test-Path $convAttemptFile) { try { $convAttempts = [int]((Get-Content $convAttemptFile -Raw).Trim()) } catch { $convAttempts = 0 } }
    if ($convAttempts -ge 3) {
        Write-Error "AD identity STILL not converged after $convAttempts attempts (name=$env:COMPUTERNAME expected=$expectedAdName PartOfDomain=$($cs.PartOfDomain) secureChannel=$secureChannelOk). Giving up to avoid a reboot loop; manual intervention required."
    } else {
        Log-Warning -Message "AD identity not converged (name=$env:COMPUTERNAME expected=$expectedAdName PartOfDomain=$($cs.PartOfDomain) secureChannel=$secureChannelOk); attempt $($convAttempts + 1)/3 -- triggering clean rejoin via the rescue path."
        $secret = Get-Secret -SecretId "{{ context.get('/configuration/UserDirectory/service_account_secret_arn') }}"
        if ($secret) {
            $sau = $secret.username.Split('@')[0]
            $sp  = ConvertTo-SecureString "$($secret.password)" -AsPlainText -Force
            $cred = New-Object System.Management.Automation.PSCredential -ArgumentList "{{ context.get('/configuration/UserDirectory/short_name') }}\$sau",$sp
            try {
                if ($cs.PartOfDomain) {
                    # AD-auth unjoin (deletes the shared object); fall back to a local WORKGROUP drop if the channel is broken.
                    try {
                        Remove-Computer -UnjoinDomainCredential $cred -WorkgroupName "WORKGROUP" -Force -ErrorAction Stop
                    } catch {
                        Log-Warning -Message "AD-auth unjoin failed ($($_.Exception.Message)); forcing local WORKGROUP drop (orphan reaped by ADComputerCleaner)"
                        $lr = $cs.UnjoinDomainOrWorkgroup($null, $null, 0)
                        if ($lr.ReturnValue -eq 0) { $cs.JoinDomainOrWorkgroup("WORKGROUP") | Out-Null }
                        else { throw "Local force-drop failed (WMI $($lr.ReturnValue))" }
                    }
                    Log-Info -Message "Left inherited domain membership; staging clean rejoin as $expectedAdName."
                }
                Set-Content -Path $convAttemptFile -Value ([string]($convAttempts + 1)) -Force
                # Drop the rescue marker so the rescue block (top of 03) finishes the rejoin.
                Set-Content -Path $rescueMarker -Value $expectedAdName -Force
                # Re-arm this post-reboot task and reboot to apply the unjoin + run the rescue.
                $reArmAction = New-ScheduledTaskAction -Execute "powershell.exe" -Argument "-ExecutionPolicy Bypass -File $EDHBootstrapAssetsFolder\03_setup_post_reboot.ps1  *> $EDHBootstrapAssetsFolder\03_setup_post_reboot.ps1.log"
                $reArmTrigger = New-ScheduledTaskTrigger -AtStartup
                $reArmSettings = New-ScheduledTaskSettingsSet -StartWhenAvailable
                Register-ScheduledTask -Action $reArmAction -Trigger $reArmTrigger -Settings $reArmSettings -TaskName $taskName -Description "EDH Final Setup post-reboot" -Force
                Log-Info -Message "AD identity repair staged; rebooting to apply, rescue block will complete the rejoin as $expectedAdName."
                Restart-Computer -Force
                Start-Sleep -Seconds 120   # hold while the reboot is pending; do not continue 03 this pass
                exit 0
            } catch {
                Write-Error "AD identity repair (unjoin/rejoin as $expectedAdName) FAILED: $($_.Exception.Message)"
            }
        } else {
            Write-Error "AD identity repair: could not retrieve service account secret; cannot converge identity."
        }
    }
} else {
    # Converged -- clear the attempt counter so a future re-bootstrap starts fresh.
    $convAttemptFile = Join-Path $EDHBootstrapAssetsFolder 'ad_converge_attempts.txt'
    if (Test-Path $convAttemptFile) { Remove-Item $convAttemptFile -Force -ErrorAction SilentlyContinue }
}
{% endif %}

