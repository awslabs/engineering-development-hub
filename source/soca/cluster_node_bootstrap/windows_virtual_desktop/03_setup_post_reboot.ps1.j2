# DCV event-relay: load the publisher early so we can emit a status
# update before the (sometimes-slow) Start-Service call.
{% include "templates/windows/dcv/dcv_event_publish.ps.j2" %}

try {
    Invoke-EdhDcvPublishEvent -EventType "bootstrap-status" `
        -SubStatus "Starting DCV server service"
} catch { Write-Warning "edh-publish: dcv-starting status threw: $_" }

