# SOCA cross-region overlay daemon.
#
# Rendered from this template by scripts/install-overlay-daemon.sh during
# controller bootstrap, when Config.services.cross_region.enabled is true, and
# written to /etc/systemd/system/edh-overlay-daemon.service. The cluster's
# identity is baked in at render time rather than looked up at start, so the
# unit does not depend on a configuration read succeeding before it can run.

[Unit]
Description=SOCA cross-region overlay daemon ({{ EDH_CLUSTER_ID }})
Documentation=file:///opt/edh/{{ EDH_CLUSTER_ID }}/cluster_manager/docs/cross_region/README.md
# The daemon resolves DynamoDB and Secrets Manager endpoints at startup, so it
# needs working DNS rather than merely a configured interface.
After=network-online.target
Wants=network-online.target
# The restart rate limit belongs to the Unit, not the Service: it is the Unit's
# start-rate state that Restart=always feeds, and StartLimitIntervalSec is the
# only spelling with an entry in the [Unit] section's parse table. Renaming these
# in place under [Service] would make them unknown directives and drop the
# interval back to the 10 second default, so the section and the name have to
# move together. Without them a persistently failing daemon restarts every
# RestartSec forever with no burst cap.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root

# Deliberately an ExecStartPre rather than a ConditionPathExists on
# /sys/module/wireguard. A condition is evaluated BEFORE ExecStartPre, so
# gating on the module already being loaded means that on a host where it is
# not yet loaded the unit is skipped and the modprobe that would have loaded it
# never runs. systemd reports that as a skipped condition rather than a
# failure, which is the quietest possible way for the mesh not to come up.
ExecStartPre=/sbin/modprobe wireguard

# EDH writes /etc/environment with shell-style "export KEY=value" lines, which
# is deliberate so the file can be sourced, and which systemd's EnvironmentFile
# rejects. Strip the prefix into a systemd-readable copy. The substitution is
# idempotent, so it keeps working if those lines ever become plain KEY=value.
# /run is tmpfs, so this is regenerated on every start.
ExecStartPre=/bin/bash -c 'sed -E "s/^[[:space:]]*export[[:space:]]+//" /etc/environment > /run/edh-overlay-daemon.env'

# Bring up the interface and its own addresses before the daemon starts. The
# daemon manages peers with wg syncconf, which requires the interface to
# already exist.
ExecStartPre=/opt/edh/{{ EDH_CLUSTER_ID }}/cluster_manager/overlay_daemon/scripts/ensure-interface.sh

ExecStart={{ EDH_PYTHON }} -m overlay_daemon serve \
    --mesh-id {{ EDH_MESH_ID }} \
    --cluster-id {{ EDH_CLUSTER_ID }} \
    --region {{ EDH_REGION }} \
    --private-key-secret-arn {{ EDH_WG_SECRET_ARN }} \
    --sync-interval {{ EDH_SYNC_INTERVAL_SECONDS }} \
    --listen-port {{ EDH_LISTEN_PORT }} \
    --mtu {{ EDH_MTU }}{% if EDH_MESH_ROLE_ARN %} \
    --mesh-role-arn {{ EDH_MESH_ROLE_ARN }}{% endif %}{% if EDH_MESH_ROLE_EXTERNAL_ID %} \
    --mesh-role-external-id {{ EDH_MESH_ROLE_EXTERNAL_ID }}{% endif %}

# Generated by the sed step above. Prefixed with `-` so the unit still loads on
# a first start, before the file exists.
EnvironmentFile=-/run/edh-overlay-daemon.env

# Baked in at render time. These take precedence over EnvironmentFile entries
# of the same name. EDH_REGION is set explicitly rather than inherited: the
# interface script runs under `set -u` and reads it, so relying on
# /etc/environment happening to carry it would turn a missing variable into an
# unbound-variable abort inside ExecStartPre.
Environment=EDH_REGION={{ EDH_REGION }}
# Set explicitly for the same reason EDH_REGION is: ensure-interface.sh requires
# it under `set -u` and uses it in the DynamoDB key, and relying on
# /etc/environment happening to carry it through the optional EnvironmentFile
# turns a missing variable into an unbound-variable abort inside ExecStartPre.
# The template substituting {{ EDH_CLUSTER_ID }} into paths is not the same thing
# as the variable being present in the unit's environment.
Environment=EDH_CLUSTER_ID={{ EDH_CLUSTER_ID }}
Environment=EDH_MESH_ID={{ EDH_MESH_ID }}
Environment=EDH_WG_SECRET_ARN={{ EDH_WG_SECRET_ARN }}
Environment=EDH_LISTEN_PORT={{ EDH_LISTEN_PORT }}
Environment=EDH_MTU={{ EDH_MTU }}
# Read by overlay_daemon.table_names to resolve the per-mesh physical table
# names. Without it the daemon refuses to start rather than guessing.
Environment=EDH_MESH_TABLE_PREFIX={{ EDH_MESH_TABLE_PREFIX }}
Environment=PYTHONPATH=/opt/edh/{{ EDH_CLUSTER_ID }}/cluster_manager
Environment=LOG_LEVEL=INFO

Restart=always
RestartSec=10

# Hardening. ProtectSystem=true rather than full or strict: it makes /usr and
# /boot read-only while leaving /etc writable, which the daemon needs in order
# to rewrite its managed block in /etc/hosts and to read the interface key
# under /etc/wireguard.
#
# ReadWritePaths is deliberately NOT set. Naming a path there makes systemd
# enter a mount namespace, and a listed path that does not yet exist fails the
# unit outright with a namespacing error, which previously meant the installer
# had to pre-create a file purely to satisfy the sandbox. ProtectSystem=true
# already grants what is needed here.
NoNewPrivileges=true
ProtectSystem=true
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

# CAP_NET_ADMIN manages the WireGuard interface and its routes, and
# CAP_IPC_LOCK keeps key material out of swap. CAP_SYS_MODULE is in the
# bounding set only, for the modprobe above, and is not held by the daemon
# itself.
AmbientCapabilities=CAP_NET_ADMIN CAP_IPC_LOCK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_IPC_LOCK CAP_SYS_MODULE

StandardOutput=journal
StandardError=journal
SyslogIdentifier=edh-overlay-daemon

[Install]
WantedBy=multi-user.target
