# INPUT_FILE="input_${PBS_ARRAY_INDEX}.dat"
# ./my_solver --input "${INPUT_FILE}" --output "result_${PBS_ARRAY_INDEX}.dat"

echo "Job array subjob ${PBS_ARRAY_INDEX} submitted via the web interface"

